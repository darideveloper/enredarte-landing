{
  "name": "enredarte-landing",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.18.3"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--use-openssl-ca portless enredarte-landing pnpm astro dev",
