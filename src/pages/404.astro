---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
import Headline from "@/components/atoms/Headline.astro"
import Btn from "@/components/atoms/Btn.astro"
import { getTranslations } from "@/lib/i18n/utils"

const tEs = getTranslations("es")
const tEn = getTranslations("en")

const title = tEs("pages.notFound.title") as string
const description = tEs("pages.notFound.description") as string
const enTitle = tEn("pages.notFound.title") as string
---

<PageSEO lang="es" title={title} description={description} noIndex slot="seo" />

<Layout>
  <section class="mx-auto grid min-h-[60svh] w-full max-w-3xl place-items-center px-6 py-16 text-center md:px-14">
    <div>
      <Headline>{tEs("pages.notFound.eyebrow")}</Headline>
      <p class="mt-6 font-serif text-6xl leading-none text-ink md:text-7xl">404</p>
      <h1 class="mt-4 font-serif text-3xl text-ink md:text-4xl">{title}</h1>
      <p class="mt-3 text-xs uppercase tracking-[0.14em] text-muted">{enTitle}</p>
      <div class="mx-auto mt-6 h-px w-12 bg-crimson" aria-hidden="true"></div>
      <p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-muted">{description}</p>
      <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-muted">{tEn("pages.notFound.description") as string}</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Btn variant="primary" href="/">{tEs("pages.notFound.primaryCta")} / {tEn("pages.notFound.primaryCta")}</Btn>
        <Btn variant="ghost" href="/obras">{tEs("pages.notFound.secondaryCta")} / {tEn("pages.notFound.secondaryCta")}</Btn>
      </div>
    </div>
  </section>
</Layout>
