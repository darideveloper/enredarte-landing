---
import "@/styles/global.css"
import Btn from "@/components/atoms/Btn.astro"
import Logo from "@/components/atoms/Logo.astro"
import Link from "@/components/atoms/Link.astro"
import Headline from "@/components/atoms/Headline.astro"
import Image from "@/components/atoms/Image.astro"
import { FilterBtn } from "@/components/atoms/FilterBtn"
import BannerText from "@/components/atoms/BannerText.astro"
import H1 from "@/components/molecules/H1.astro"
import Menu from "@/components/molecules/Menu.astro"
import Header from "@/components/organisms/Header.astro"
import LangBtns from "@/components/atoms/LangBtns.astro"
import CardSummary from "@/components/atoms/CardSummary.astro"
import ImageBanner from "@/components/molecules/ImageBanner.astro"
import Title from "@/components/atoms/Title.astro"
import CardInfo from "@/components/atoms/CardInfo.astro"
import { Filters } from "@/components/molecules/Filters"
import ImageCard from "@/components/molecules/ImageCard.astro"
import Gallery from "@/components/organisms/Gallery.astro"
import { Artworks } from "@/components/organisms/Artworks"

const salasData = [
  {
    src: "/images/hero-1.png",
    alt: "Sala Tierra Mundo Memoria",
    title: "Tierra, Mundo y Memoria",
    href: "#",
    isLarge: true,
    subtitle: "Sala 01 · Activa",
    meta: "6 Artistas · Los Cabos / GDL",
    curator: "Curaduría: Álvaro Macias",
  },
  {
    src: "/images/hero-2.png",
    alt: "Sala Plástica Oaxaqueña",
    title: "Plástica Oaxaqueña",
    href: "#",
    subtitle: "Sala 02 · Activa",
    meta: "4 Artistas · Oaxaca",
  },
  {
    src: "/images/hero-3.png",
    alt: "Sala Nuevas Voces",
    title: "Nuevas Voces CDMX",
    href: "#",
    subtitle: "Sala 03 · Activa",
    meta: "5 Artistas · Ciudad de México",
  },
  {
    src: "/images/hero-1.png",
    alt: "Sala San Miguel de Allende",
    title: "San Miguel de Allende",
    href: "#",
    subtitle: "Sala 04 · Próximamente",
    meta: "Curaduría: Regina Ibarra",
  },
  {
    src: "/images/hero-2.png",
    alt: "Sala Puerto Vallarta",
    title: "Puerto Vallarta",
    href: "#",
    subtitle: "Sala 05 · Próximamente",
    meta: "Territorio de Álvaro",
  }
]

const showcaseFacets = [
  {
    artist: ["alvaro-macias"],
    discipline: ["pintura"],
    technique: ["oleo"],
    theme: ["paisaje"],
    format: ["obra-original"],
    scale: ["gran-formato"],
  },
  {
    artist: ["daniel-ortega"],
    discipline: ["pintura"],
    technique: ["acrilico"],
    theme: ["abstracto"],
    format: ["obra-original"],
    scale: ["mini-obras"],
  },
  {
    artist: ["regina-ibarra"],
    discipline: ["collage"],
    technique: ["mixta"],
    theme: ["memoria"],
    format: ["obra-original"],
    scale: ["mini-obras"],
  },
]
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design System — enredarte</title>
  </head>
  <body class="bg-paper text-ink min-h-screen p-8 md:p-16 font-sans">
    <header class="max-w-5xl mx-auto border-b border-border-theme pb-6 mb-12">
      <h1 class="text-3xl font-serif font-normal mb-2">enredarte — Design System</h1>
      <p class="text-sm text-muted">Centralized library showcase for Atoms, Molecules, and Organisms.</p>
    </header>

    <main class="max-w-5xl mx-auto space-y-16">
      <!-- ATOMS -->
      <section class="space-y-6">
        <div class="border-b border-border-theme pb-2">
          <h2 class="text-xl font-serif text-crimson">1. Atoms</h2>
          <p class="text-xs text-muted uppercase tracking-wider mt-1">Smallest standalone UI components</p>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme space-y-8">
          <!-- Btn Showcase -->
          <div>
            <h3 class="text-sm font-semibold mb-4 text-ink">Btn Component (`src/components/atoms/Btn.astro`)</h3>
            <div class="flex flex-wrap items-center gap-6 p-4 bg-paper border border-border-theme rounded">
              <!-- Primary Variant -->
              <div class="space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">variant="primary" (hero CTA)</span>
                <Btn variant="primary" href="#">Entrar a la Sala</Btn>
              </div>

              <!-- Ghost Variant -->
              <div class="space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">variant="ghost"</span>
                <Btn variant="ghost" size="sm" href="#">Ghost Button</Btn>
              </div>

              <!-- Outline Variant -->
              <div class="space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">variant="outline" (hero secondary CTA)</span>
                <Btn variant="outline" href="#">Ver Manifiesto</Btn>
              </div>
            </div>
          </div>

          <!-- FilterBtn Showcase -->
          <div>
            <h3 class="text-sm font-semibold mb-4 text-ink">FilterBtn Component (`src/components/atoms/FilterBtn.tsx`)</h3>
            <div class="flex flex-wrap items-center gap-4 p-4 bg-paper border border-border-theme rounded">
              <div class="space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">group="artist" value="alvaro-macias"</span>
                <FilterBtn group="artist" value="alvaro-macias" label="Álvaro Macias" client:load />
              </div>
              <div class="space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">group="artist" value="daniel-ortega"</span>
                <FilterBtn group="artist" value="daniel-ortega" label="Daniel Ortega" client:load />
              </div>
              <div class="space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">group="discipline" value="pintura"</span>
                <FilterBtn group="discipline" value="pintura" label="Pintura" client:load />
              </div>
              <div class="space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">group="technique" value="lapiz" disabled</span>
                <FilterBtn group="technique" value="lapiz" label="Lápiz" disabled client:load />
              </div>
            </div>
          </div>

          <!-- BannerText Showcase -->
          <div>
            <h3 class="text-sm font-semibold mb-4 text-ink">BannerText Component (`src/components/atoms/BannerText.astro`)</h3>
            <div class="flex flex-wrap items-center gap-8 p-4 bg-paper border border-border-theme rounded">
              <BannerText><b>COA</b> firmado en cada obra</BannerText>
              <BannerText><b>Envío asegurado</b> DHL / FedEx</BannerText>
              <BannerText>El artista recibe el <b>65%</b></BannerText>
            </div>
          </div>

          <!-- Logo Showcase -->
          <div>
            <h3 class="text-sm font-semibold mb-4 text-ink">Logo Component (`src/components/atoms/Logo.astro`)</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Default Variant -->
              <div class="p-4 bg-paper border border-border-theme rounded space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">variant="default" (logo.png)</span>
                <Logo variant="default" />
              </div>

              <!-- Dark Variant -->
              <div class="p-4 bg-paper border border-border-theme rounded space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">variant="dark" (logo-dark.png)</span>
                <Logo variant="dark" />
              </div>

              <!-- Light Variant -->
              <div class="p-4 bg-ink text-paper border border-border-theme rounded space-y-2">
                <span class="block text-[10px] uppercase text-muted/60 font-mono">variant="light" (logo-light.png)</span>
                <Logo variant="light" />
              </div>

              <!-- Red BG Variant -->
              <div class="p-4 bg-paper border border-border-theme rounded space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">variant="bg-red" (logo-bg-red.png)</span>
                <Logo variant="bg-red" />
              </div>

              <!-- Icon Variant -->
              <div class="p-4 bg-paper border border-border-theme rounded space-y-2">
                <span class="block text-[10px] uppercase text-muted font-mono">variant="icon" (favicon.svg)</span>
                <Logo variant="icon" />
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme">
          <h3 class="text-sm font-semibold mb-4 text-ink">Image Component (`src/components/atoms/Image.astro`)</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 bg-paper border border-border-theme rounded">
            <!-- Default (Auto) -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">aspectRatio="auto" (default)</span>
              <div class="border border-dashed border-border-theme h-32 w-full">
                <Image src="/images/hero-1.png" alt="Test image auto" />
              </div>
            </div>

            <!-- Video (16:9) -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">aspectRatio="video"</span>
              <div class="border border-dashed border-border-theme w-full">
                <Image src="/images/hero-2.png" alt="Test image video" aspectRatio="video" />
              </div>
            </div>

            <!-- Square (1:1) -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">aspectRatio="square"</span>
              <div class="border border-dashed border-border-theme w-32">
                <Image src="/images/hero-3.png" alt="Test image square" aspectRatio="square" />
              </div>
            </div>

            <!-- 4/5 Aspect -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">aspectRatio="4/5"</span>
              <div class="border border-dashed border-border-theme w-32">
                <Image src="/images/hero-1.png" alt="Test image 4/5" aspectRatio="4/5" />
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme">
          <h3 class="text-sm font-semibold mb-4 text-ink">Link Component (`src/components/atoms/Link.astro`)</h3>
          
          <div class="space-y-6">
            <!-- Default Variant -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">variant="default"</span>
              <div class="flex flex-wrap gap-6 items-center p-4 bg-paper border border-border-theme rounded">
                <Link href="#internal">Internal Link</Link>
                <Link href="https://example.com" target="_blank" rel="noopener noreferrer">External Link</Link>
                <Link href="#" class="font-bold text-crimson">Custom Styled Link</Link>
              </div>
            </div>

            <!-- Nav Variant -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">variant="nav"</span>
              <div class="flex flex-wrap gap-6 items-center p-4 bg-paper border border-border-theme rounded">
                <Link variant="nav" href="#home">Home</Link>
                <Link variant="nav" href="#about">About</Link>
                <Link variant="nav" href="#contact">Contact</Link>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme">
          <h3 class="text-sm font-semibold mb-4 text-ink">Headline Component (`src/components/atoms/Headline.astro`)</h3>
          
          <div class="space-y-6">
            <div class="flex flex-wrap gap-6 items-center p-4 bg-paper border border-border-theme rounded">
              <!-- Red Variant -->
              <div class="space-y-2 text-center">
                <span class="block text-[10px] uppercase text-muted font-mono">color="red" (default)</span>
                <Headline>Exhibición del mes</Headline>
              </div>

              <!-- Muted Variant -->
              <div class="space-y-2 text-center">
                <span class="block text-[10px] uppercase text-muted font-mono">color="muted"</span>
                <Headline color="muted">Categoría secundaria</Headline>
              </div>

              <!-- Default Ink Variant -->
              <div class="space-y-2 text-center">
                <span class="block text-[10px] uppercase text-muted font-mono">color="default"</span>
                <Headline color="default">Texto regular</Headline>
              </div>
            </div>
          </div>
        </div>

      </section>

      <!-- MOLECULES -->
      <section class="space-y-6">
        <div class="border-b border-border-theme pb-2">
          <h2 class="text-xl font-serif text-crimson">2. Molecules</h2>
          <p class="text-xs text-muted uppercase tracking-wider mt-1">Combinations of atoms working together</p>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme">
          <h3 class="text-sm font-semibold mb-4 text-ink">Filters Component (`src/components/molecules/Filters.tsx`)</h3>
          <div class="space-y-4 p-6 bg-paper border border-border-theme rounded">
            <div>
              <span class="block text-[10px] uppercase text-muted font-mono mb-2">Localized facet groups</span>
              <Filters
                client:load
                expandLabel="Ver más filtros"
                collapseLabel="Ver menos filtros"
                facets={showcaseFacets}
                groups={[
                  {
                    key: "artist",
                    label: "Por artista",
                    options: [
                      { value: "alvaro-macias", label: "Álvaro Macias" },
                      { value: "daniel-ortega", label: "Daniel Ortega" },
                      { value: "regina-ibarra", label: "Regina Ibarra" },
                    ],
                  },
                  {
                    key: "technique",
                    label: "Por técnica",
                    options: [
                      { value: "acrilico", label: "Acrílico" },
                      { value: "oleo", label: "Óleo" },
                      { value: "acuarela", label: "Acuarela" },
                      { value: "mixta", label: "Mixta" },
                      { value: "tinta", label: "Tinta" },
                    ],
                  },
                ]}
              />
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme">
          <h3 class="text-sm font-semibold mb-4 text-ink">H1 Component (`src/components/molecules/H1.astro`)</h3>
          <div class="space-y-8 p-6 bg-paper border border-border-theme rounded">
            <!-- With Headline -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">With slotted Headline</span>
              <div class="border border-dashed border-border-theme p-4">
                <H1>
                  <Headline color="muted">Exhibición del mes</Headline>
                  Tierra, mundo<br/>y memoria
                </H1>
              </div>
            </div>

            <!-- Without Headline -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">Without Headline</span>
              <div class="border border-dashed border-border-theme p-4">
                <H1>Artistas<br/>invitados</H1>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme">
          <h3 class="text-sm font-semibold mb-4 text-ink">LangBtns Component (`src/components/atoms/LangBtns.astro`)</h3>
          <div class="flex items-center gap-6 p-4 bg-paper border border-border-theme rounded">
            <!-- Simulated English page -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">lang="en" (EN active)</span>
              <LangBtns lang="en" />
            </div>

            <!-- Simulated Spanish page -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">lang="es" (ES active)</span>
              <LangBtns lang="es" />
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme">
          <h3 class="text-sm font-semibold mb-4 text-ink">Menu Component (`src/components/molecules/Menu.astro`)</h3>
          <div class="p-8 bg-paper border border-border-theme rounded">
            <Menu links={[
              { label: "Home", href: "#home" },
              { label: "Obras", href: "#obras" },
              { label: "Salas", href: "#salas" },
              { label: "Artistas", href: "#artistas" }
            ]} />
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme">
          <h3 class="text-sm font-semibold mb-4 text-ink">CardSummary Component (`src/components/atoms/CardSummary.astro`)</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-paper border border-border-theme rounded">
            <!-- Full props -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">Full props (title, artist, price, href)</span>
              <div class="p-6 bg-[url('/images/hero-1.png')] bg-cover bg-center rounded">
                <CardSummary
                  title="El silencio de la tierra"
                  artist="Martín Chirino"
                  priceMxn={12500}
                  lang="es"
                  href="/obras/1"
                />
              </div>
            </div>

            <!-- Title only -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">Title and href only</span>
              <div class="p-6 bg-[url('/images/hero-2.png')] bg-cover bg-center rounded">
                <CardSummary
                  title="Construcción en el espacio"
                  href="/obras/2"
                  lang="es"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme mt-8">
          <h3 class="text-sm font-semibold mb-4 text-ink">ImageBanner Component (`src/components/molecules/ImageBanner.astro`)</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-paper border border-border-theme rounded">
            <!-- Full data -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">Full data</span>
              <div class="border border-dashed border-border-theme overflow-hidden">
                <ImageBanner
                  src="/images/hero-1.png"
                  alt="Artwork 1"
                  aspectRatio="square"
                  title="El silencio de la tierra"
                  artist="Martín Chirino"
                  priceMxn={12500}
                  lang="es"
                  href="/obras/1"
                />
              </div>
            </div>

            <!-- Partial data -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">Partial data (No artist/price)</span>
              <div class="border border-dashed border-border-theme overflow-hidden">
                <ImageBanner
                  src="/images/hero-2.png"
                  alt="Artwork 2"
                  aspectRatio="square"
                  title="Construcción en el espacio"
                  lang="es"
                  href="/obras/2"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme mt-8">
          <h3 class="text-sm font-semibold mb-4 text-ink">Title Component (`src/components/atoms/Title.astro`)</h3>
          <div class="space-y-6 p-6 bg-paper border border-border-theme rounded">
            <!-- With Link -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">With Link</span>
              <div class="border border-dashed border-border-theme p-4">
                <Title linkText="VER TODO" linkHref="/salas">
                  <Headline color="red">Pabellón de Salas</Headline>
                </Title>
              </div>
            </div>

            <!-- Without Link -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">Without Link</span>
              <div class="border border-dashed border-border-theme p-4">
                <Title>
                  <Headline color="red">Artistas</Headline>
                </Title>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme mt-8">
          <h3 class="text-sm font-semibold mb-4 text-ink">CardInfo Component (`src/components/atoms/CardInfo.astro`)</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-paper border border-border-theme rounded">
            <!-- Full data -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">Full data</span>
              <div class="border border-dashed border-border-theme bg-ink h-64 relative overflow-hidden">
                <CardInfo 
                  title="Sala de la luz"
                  href="/salas/1"
                  subtitle="EXHIBICIÓN ACTUAL"
                  meta="12 OBRAS / PINTURA"
                  curator="Curaduría: Elena Blanco"
                />
              </div>
            </div>

            <!-- Partial data -->
            <div class="space-y-2">
              <span class="block text-[10px] uppercase text-muted font-mono">Title only</span>
              <div class="border border-dashed border-border-theme bg-ink h-64 relative overflow-hidden">
                <CardInfo 
                  title="Formas del vacío"
                  href="/salas/2"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ORGANISMS -->
      <section class="space-y-6">
        <div class="border-b border-border-theme pb-2">
          <h2 class="text-xl font-serif text-crimson">3. Organisms</h2>
          <p class="text-xs text-muted uppercase tracking-wider mt-1">Complex sections mapping to screen regions</p>
        </div>

        <div class="bg-white/50 p-6 rounded border border-border-theme space-y-4">
          <h3 class="text-sm font-semibold text-ink">Header Component (`src/components/organisms/Header.astro`)</h3>
          <div class="border border-border-theme rounded overflow-hidden">
            <Header class="static" />
          </div>
        </div>
        <div class="bg-white/50 p-6 rounded border border-border-theme space-y-4 mt-8">
          <h3 class="text-sm font-semibold text-ink">Gallery Component (`src/components/organisms/Gallery.astro`)</h3>
          <div class="border border-border-theme bg-paper rounded overflow-hidden">
            <Gallery salas={salasData} />
          </div>
        </div>
        <div class="bg-white/50 p-6 rounded border border-border-theme space-y-4 mt-8">
          <h3 class="text-sm font-semibold text-ink">Artworks Component (`src/components/organisms/Artworks.tsx`)</h3>
          <div class="border border-border-theme bg-paper p-4 rounded overflow-hidden">
            <Artworks client:load loadingLabel="Cargando…">
              {[
                {
                  src: "/images/abstract-landscape-oil.jpg",
                  alt: "Horizonte en tres tiempos",
                  title: "Horizonte en tres tiempos",
                  href: "#",
                  meta: "Álvaro Macias",
                  curator: "Consultar",
                  artist: "alvaro-macias",
                  discipline: "pintura",
                  technique: "oleo",
                  theme: "paisaje",
                  format: "obra-original",
                  scale: "gran-formato",
                },
                {
                  src: "/images/painting-abstract-details.jpg",
                  alt: "Raíz",
                  title: "Raíz",
                  href: "#",
                  meta: "Daniel Ortega",
                  curator: "Consultar",
                  artist: "daniel-ortega",
                  discipline: "pintura",
                  technique: "acrilico",
                  theme: "abstracto",
                  format: "obra-original",
                  scale: "mini-obras",
                },
                {
                  src: "/images/cityscape-madrid-gran-via.jpg",
                  alt: "Concreto y Memoria",
                  title: "Concreto y Memoria",
                  href: "#",
                  meta: "Regina Ibarra",
                  curator: "Consultar",
                  artist: "regina-ibarra",
                  discipline: "pintura",
                  technique: "mixta",
                  theme: "urbano",
                  format: "obra-original",
                  scale: "gran-formato",
                },
                {
                  src: "/images/artist-street-exhibition.jpg",
                  alt: "Costa Interior",
                  title: "Costa Interior",
                  href: "#",
                  meta: "Mariana Solís",
                  curator: "Consultar",
