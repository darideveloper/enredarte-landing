---
import { BUSINESS_DATA } from "@/data/site-config"
import { SITE_TITLE, SITE_DESCRIPTION, LOCALE_MAP } from "@/consts"
import { getLocalizedPath, getTranslations } from "@/lib/i18n/utils"
import { stripMarkdown } from "@/lib/markdown"

export interface Props {
  currentPage?: string
  lang?: "es" | "en"
  title?: string
  description?: string
  keywords?: string
  jsonType?: string
  extraJson?: Record<string, any>
  ogImage?: string
  ogImageAlt?: string
  ogImageWidth?: number
  ogImageHeight?: number
  alternateUrls?: { en: string; es: string }
  useTagLine?: boolean
  noIndex?: boolean
  articlePublishedTime?: string
  articleAuthor?: string
}

const {
  currentPage,
  lang = "es",
  title,
  description,
  keywords,
  jsonType = "LocalBusiness",
  extraJson = {},
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  alternateUrls,
  useTagLine = true,
  noIndex,
  articlePublishedTime,
  articleAuthor,
} = Astro.props

const t = getTranslations(lang)
const i18nTitle = currentPage ? t(`pages.${currentPage}.title`) : undefined
const i18nDesc = currentPage ? t(`pages.${currentPage}.description`) : undefined
const i18nKeywords = currentPage ? t(`pages.${currentPage}.keywords`) : undefined

const resolvedTitle = title || i18nTitle || SITE_TITLE
// Descriptions may be authored as markdown — meta tags always get plain text.
const resolvedDescription = stripMarkdown(description || i18nDesc || SITE_DESCRIPTION)
const resolvedKeywords = keywords || i18nKeywords
const pageTitle = useTagLine && resolvedTitle !== BUSINESS_DATA.name && currentPage !== "home"
  ? `${resolvedTitle} | ${BUSINESS_DATA.name}`
  : resolvedTitle

// Origin: Astro.site (PORTLESS_URL → SITE_URL → prod chain) with a safe fallback
// to the business URL, matching the sitemap origin so canonical/hreflang/OG/JSON-LD
// all agree per environment.
const origin = Astro.site ?? BUSINESS_DATA.url

// Absolutize any path (relative or already-absolute) against the resolved origin,
// so hreflang/OG/JSON-LD always emit full URLs with return links.
const absolutize = (url: string) =>
  /^https?:\/\//.test(url) ? url : new URL(url, origin).href

const canonicalPath = currentPage ? getLocalizedPath(currentPage, lang) : Astro.url.pathname
const canonicalUrl = absolutize(canonicalPath)

const socialImageUrl = ogImage && ogImage.trim() !== ""
  ? absolutize(ogImage)
  : absolutize(BUSINESS_DATA.ogImage)

const resolvedAlternateUrls = alternateUrls ?? (currentPage
  ? {
      en: getLocalizedPath(currentPage, "en"),
      es: getLocalizedPath(currentPage, "es"),
    }
  : undefined)
const resolvedAlternateUrlsAbs = resolvedAlternateUrls && {
  en: absolutize(resolvedAlternateUrls.en),
  es: absolutize(resolvedAlternateUrls.es),
}

// og:type mapping per JSON-LD type (docs: Blog→blog, BlogPosting→article, else website)
const ogTypeMap: Record<string, string> = {
  Blog: "blog",
  BlogPosting: "article",
}
const ogType = ogTypeMap[jsonType] ?? "website"
---
<title>{pageTitle}</title>
<meta name="description" content={resolvedDescription} />
{resolvedKeywords && <meta name="keywords" content={resolvedKeywords} />}
<link rel="canonical" href={canonicalUrl} />
{resolvedAlternateUrlsAbs && <link rel="alternate" hreflang="en" href={resolvedAlternateUrlsAbs.en} />}
{resolvedAlternateUrlsAbs && <link rel="alternate" hreflang="es" href={resolvedAlternateUrlsAbs.es} />}
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={LOCALE_MAP[lang]} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImageUrl} />
{ogImageWidth && ogImageHeight && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageWidth && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={socialImageUrl} />
{jsonType === "BlogPosting" && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
{jsonType === "BlogPosting" && articleAuthor && <meta property="article:author" content={articleAuthor} />}
{!import.meta.env.PROD && <meta name="robots" content="noindex, nofollow" />}
{noIndex && <meta name="robots" content="noindex, nofollow" />}

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": jsonType,
  name: BUSINESS_DATA.name,
  url: canonicalUrl,
  image: socialImageUrl,
  ...(jsonType === "LocalBusiness" ? {
    telephone: BUSINESS_DATA.contact.phone,
    address: BUSINESS_DATA.contact.address,
    sameAs: Object.values(BUSINESS_DATA.social).filter(Boolean),
  } : {}),
  ...extraJson,
})} />
