---
import Headline from "@/components/atoms/Headline.astro"
import Image from "@/components/atoms/Image.astro"
import { getTranslations, pickTranslation } from "@/lib/i18n/utils"
import { stripUrlScheme, cn } from "@/lib/utils"
import type { ArtCurator, Lang } from "@/lib/api/types"

export interface Props {
  curator: ArtCurator
  lang: Lang
  bio?: string
  class?: string
}

const { curator, lang, bio: customBio, class: className } = Astro.props
const t = getTranslations(lang)
const bio = customBio ?? pickTranslation(curator.translations, lang, "bio")

const initials = curator.name
  .split(/\s+/)
  .map((word) => word[0])
  .join("")
  .slice(0, 2)
  .toUpperCase()
---

<section class={cn("bg-paper px-6 md:px-14 pt-16 md:pt-24 pb-12 overflow-hidden", className)} transition:animate="none">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[300px_1fr] lg:grid-cols-[360px_1fr] gap-10 md:gap-16 items-start">
    <div class="relative aspect-[4/5] overflow-hidden bg-ink shadow-sm">
      {curator.photo ? (
        <Image src={curator.photo} alt={curator.name} class="absolute inset-0 w-full h-full object-cover" />
      ) : (
        <span class="absolute inset-0 flex items-center justify-center text-paper/30 font-serif text-6xl">
          {initials}
        </span>
      )}
    </div>

    <div class="min-w-0">
      <Headline color="muted" class="block mb-3 tracking-[0.2em]">
        {t("global.curator.curator")}
      </Headline>
      <h1 class="font-serif text-4xl md:text-5xl text-ink leading-[1.1] mb-6">
        {curator.name}
      </h1>

      {bio && (
        <p class="text-[15px] text-muted leading-[1.85] mb-8 max-w-2xl">
          {bio}
        </p>
      )}

      {(curator.email || curator.website) && (
        <div class="flex flex-wrap gap-6 text-[12px] tracking-[0.06em] uppercase pt-2 border-t border-border-theme">
          {curator.email && (
            <a
              href={`mailto:${curator.email}`}
              class="text-crimson hover:underline font-medium transition-colors"
            >
              {curator.email}
            </a>
          )}
          {curator.website && (
            <a
              href={curator.website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-crimson hover:underline font-medium transition-colors"
            >
              {stripUrlScheme(curator.website)}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
