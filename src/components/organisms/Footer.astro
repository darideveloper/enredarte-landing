---
import { BUSINESS_DATA } from "../../data/site-config"
import { routes, type PageKey } from "../../lib/i18n/routes"
import { getLocalizedPath, getTranslations } from "../../lib/i18n/utils"

const { lang, pageKey } = Astro.props
const t = getTranslations(lang)
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-900">
          {t("global.nav.home")}
        </h3>
        <p class="text-sm text-gray-600">{t("pages.home.description")}</p>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-900">
          {t("global.footer.links")}
        </h3>
        <ul class="space-y-2">
          {["home", "services", "about"].map((key) => (
            <li>
              <a
                href={getLocalizedPath(key, lang)}
                class="text-sm text-gray-600 transition-colors hover:text-brand-500"
              >
                {t(`global.nav.${key}`)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-900">
          {t("global.footer.contact")}
        </h3>
        <p class="text-sm text-gray-600">{BUSINESS_DATA.contact.email}</p>
        {BUSINESS_DATA.social.facebook && (
          <a
            href={BUSINESS_DATA.social.facebook}
            class="mt-1 block text-sm text-gray-600 transition-colors hover:text-brand-500"
          >
            Facebook
          </a>
        )}
        {BUSINESS_DATA.social.instagram && (
          <a
            href={BUSINESS_DATA.social.instagram}
            class="mt-1 block text-sm text-gray-600 transition-colors hover:text-brand-500"
          >
            Instagram
          </a>
        )}
      </div>
    </div>

    <div class="mt-8 border-t border-gray-200 pt-8 text-center text-sm text-gray-500">
      &copy; {new Date().getFullYear()} {BUSINESS_DATA.name}. All rights reserved.
    </div>
  </div>
</footer>
