---
import { cn } from "@/lib/utils"
import BannerText from "@/components/atoms/BannerText.astro"

export interface Props {
  class?: string
}

const { class: className, ...props } = Astro.props
---

<div id="banner-bar" class={cn("flex justify-center items-center gap-6 md:gap-[56px] px-6 md:px-12 py-[22px] bg-banner-bg flex-wrap border-y border-border-theme overflow-hidden", className)} transition:animate="none" {...props}>
  <BannerText class="banner-bar-item"><b>COA</b> firmado en cada obra</BannerText>
  <BannerText class="banner-bar-item"><b>Envío asegurado</b> DHL / FedEx</BannerText>
  <BannerText class="banner-bar-item">El artista recibe el <b>65%</b></BannerText>
  <BannerText class="banner-bar-item"><b>Curaduría personal</b> — no marketplace</BannerText>
</div>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap"

  let mm

  const initBannerBarAnimation = () => {
    if (!document.querySelector("#banner-bar")) return
    mm?.revert()
    mm = gsap.matchMedia()

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.fromTo(
        ".banner-bar-item",
        { y: 25, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: "power2.out",
          clearProps: "transform,opacity",
          scrollTrigger: {
            trigger: "#banner-bar",
            start: "top 85%",
          },
        }
      )
    })
    mm.add("(prefers-reduced-motion: reduce)", () => {
      // no-op: content is visible by default with fromTo+clearProps
    })
  }

  document.addEventListener("astro:after-swap", () => mm?.revert())
  document.addEventListener("astro:page-load", initBannerBarAnimation)
  initBannerBarAnimation()
</script>
