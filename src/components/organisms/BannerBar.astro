---
import { cn } from "../../lib/utils";
import BannerText from "../atoms/BannerText.astro";

export interface Props {
  class?: string;
}

const { class: className, ...props } = Astro.props;
---

<div class={cn("flex justify-center items-center gap-6 md:gap-[56px] px-6 md:px-12 py-[22px] bg-banner-bg flex-wrap border-y border-border-theme", className)} {...props}>
  <BannerText><b>COA</b> firmado en cada obra</BannerText>
  <BannerText><b>Envío asegurado</b> DHL / FedEx</BannerText>
  <BannerText>El artista recibe el <b>65%</b></BannerText>
  <BannerText><b>Curaduría personal</b> — no marketplace</BannerText>
</div>
