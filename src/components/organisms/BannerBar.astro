---
import { cn } from "@/lib/utils"
import BannerText from "@/components/atoms/BannerText.astro"
import type { Lang } from "@/lib/api/types"
import { getTranslations } from "@/lib/i18n/utils"

export interface Props {
  class?: string
  lang: Lang
}

const { class: className, lang, ...props } = Astro.props
const t = getTranslations(lang)
---

<div id="banner-bar" class={cn("flex justify-center items-center gap-6 md:gap-[56px] px-6 md:px-12 py-[22px] bg-banner-bg flex-wrap border-y border-border-theme overflow-hidden", className)} transition:animate="none" {...props}>
  <BannerText class="banner-bar-item"><Fragment set:html={t("global.banner.coa")} /></BannerText>
  <BannerText class="banner-bar-item"><Fragment set:html={t("global.banner.shipping")} /></BannerText>
  <BannerText class="banner-bar-item"><Fragment set:html={t("global.banner.artistShare")} /></BannerText>
  <BannerText class="banner-bar-item"><Fragment set:html={t("global.banner.curation")} /></BannerText>
</div>

<script>
  import { gsap } from "@/lib/gsap"

  let mm: ReturnType<typeof gsap.matchMedia> | undefined

  const initBannerBarAnimation = () => {
    if (!document.querySelector("#banner-bar")) return
    mm?.revert()
    mm = gsap.matchMedia()

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.fromTo(
        ".banner-bar-item",
        { y: 25, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: "power2.out",
          clearProps: "transform,opacity",
          scrollTrigger: {
            trigger: "#banner-bar",
            start: "top 85%",
          },
        }
      )
    })
    mm.add("(prefers-reduced-motion: reduce)", () => {
      // no-op: content is visible by default with fromTo+clearProps
    })
  }

  document.addEventListener("astro:after-swap", () => mm?.revert())
  document.addEventListener("astro:page-load", initBannerBarAnimation)
  initBannerBarAnimation()
</script>
