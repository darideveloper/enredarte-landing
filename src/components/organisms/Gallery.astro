---
import { cn } from "@/lib/utils";
import Title from "@/components/atoms/Title.astro";
import Headline from "@/components/atoms/Headline.astro";
import ImageCard from "@/components/molecules/ImageCard.astro";

export interface SalaData {
  src: string;
  alt: string;
  title: string;
  href: string;
  isLarge?: boolean;
  subtitle?: string;
  meta?: string;
  curator?: string;
}

export interface Props {
  salas: SalaData[];
  class?: string;
}

const { salas, class: className, ...props } = Astro.props;
---

<section class={cn("bg-paper px-6 md:px-14 pt-16 md:pt-24 pb-16 md:pb-24", className)} {...props}>
  <Title>
    <Headline color="muted" class="block mb-2 tracking-[0.2em]">Explora</Headline>
    Pabellón de Salas
  </Title>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr] auto-rows-[280px] md:auto-rows-[340px] gap-1">
    {salas.map(sala => (
      <ImageCard 
        {...sala}
      />
    ))}
  </div>
</section>
