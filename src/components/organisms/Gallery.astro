---
import { cn } from "@/lib/utils";
import Title from "@/components/atoms/Title.astro";
import Headline from "@/components/atoms/Headline.astro";
import ImageCard from "@/components/molecules/ImageCard.astro";

export interface SalaData {
  src: string;
  alt: string;
  title: string;
  href: string;
  isLarge?: boolean;
  subtitle?: string;
  meta?: string;
  curator?: string;
}

export interface Props {
  salas: SalaData[];
  class?: string;
}

const { salas, class: className, ...props } = Astro.props;
---

<section id="salas-gallery" class={cn("bg-paper px-6 md:px-14 pt-16 md:pt-24 pb-16 md:pb-24 overflow-hidden", className)} {...props}>
  <div class="gallery-header">
    <Title>
      <Headline color="muted" class="block mb-2 tracking-[0.2em]">Explora</Headline>
      Pabellón de Salas
    </Title>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr] auto-rows-[280px] md:auto-rows-[340px] gap-1 gallery-grid">
    {salas.map(sala => (
      <ImageCard 
        {...sala}
        class={cn(sala.isLarge ? "gallery-card-large" : "gallery-card-item")}
      />
    ))}
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap";

  const initGalleryAnimation = () => {
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.fromTo(
        ".gallery-header",
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          ease: "power2.out",
          clearProps: "transform,opacity",
          scrollTrigger: {
            trigger: "#salas-gallery",
            start: "top 85%",
          },
        }
      );

      gsap.fromTo(
        ".gallery-card-large, .gallery-card-item",
        { y: 40, scale: 0.96, opacity: 0 },
        {
          y: 0,
          scale: 1,
          opacity: 1,
          duration: 0.8,
          stagger: 0.12,
          ease: "power2.out",
          clearProps: "transform,opacity",
          scrollTrigger: {
            trigger: ".gallery-grid",
            start: "top 80%",
          },
        }
      );
    });
  };

  document.addEventListener("astro:page-load", initGalleryAnimation);
</script>
