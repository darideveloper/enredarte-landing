---
import { cn } from "../../lib/utils";
import Title from "../molecules/Title.astro";
import Headline from "../atoms/Headline.astro";
import ImageCard from "../molecules/ImageCard.astro";

export interface SalaData {
  src: string;
  alt: string;
  title: string;
  href: string;
  isLarge?: boolean;
  subtitle?: string;
  meta?: string;
  curator?: string;
}

export interface Props {
  salas: SalaData[];
  class?: string;
}

const { salas, class: className, ...props } = Astro.props;
---

<section class={cn("px-14 pb-24", className)} {...props}>
  <Title linkText="Ver todas las salas →" linkHref="/salas">
    <Headline color="muted" class="block mb-2 tracking-[0.2em]">Explora</Headline>
    Pabellón de Salas
  </Title>
  <div class="grid grid-cols-[1.4fr_1fr_1fr] grid-rows-[340px_340px] gap-1">
    {salas.map(sala => (
      <ImageCard 
        {...sala}
      />
    ))}
  </div>
</section>
