---
import Logo from "@/components/atoms/Logo.astro"
import LangBtns from "@/components/atoms/LangBtns.astro"
import Menu from "@/components/molecules/Menu.astro"
import { cn } from "@/lib/utils"
import { getLangFromUrl, getLocalizedPath } from "@/lib/i18n/utils"
import { getNavLinks } from "@/lib/nav"

export interface Props {
  class?: string
  localizedPaths?: Record<"en" | "es", string>
}

const { class: className, localizedPaths } = Astro.props
const lang = getLangFromUrl(Astro.url)

const navLinks = getNavLinks(lang)
---

<header class={cn("sticky top-0 z-50 bg-paper border-b border-border-theme px-6 md:px-14 py-4.5", className)}>
  <div class="flex items-center justify-between">
    <!-- Left: Logo Atom -->
    <Logo variant="default" href={getLocalizedPath("home", lang)} class="h-10" />

    <!-- Center: Navigation Links (Responsive Drawer / Row) -->
    <Menu id="main-menu" links={navLinks} />

    <!-- Right: Language Switcher & Hamburger Toggle -->
    <div class="flex items-center gap-4.5">
      <LangBtns localizedPaths={localizedPaths} />

      <button id="mobile-menu-btn" class="md:hidden flex flex-col justify-center gap-1.5 w-6 h-6 z-50 relative" aria-label="Toggle menu">
        <span class="block w-full h-[2px] bg-ink transition-transform duration-300 origin-center"></span>
        <span class="block w-full h-[2px] bg-ink transition-opacity duration-300"></span>
        <span class="block w-full h-[2px] bg-ink transition-transform duration-300 origin-center"></span>
      </button>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn')
    const menu = document.getElementById('main-menu')
    
    if (btn && menu) {
      const spans = btn.querySelectorAll('span')
      
      btn.addEventListener('click', () => {
        const isClosed = menu.classList.contains('translate-x-full')
        
        if (isClosed) {
          // Open menu
          menu.classList.remove('translate-x-full')
          menu.classList.add('translate-x-0')
          
          // Animate to X
          if (spans.length === 3) {
            spans[0]?.classList.add('rotate-45', 'translate-y-[8px]')
            spans[1]?.classList.add('opacity-0')
            spans[2]?.classList.add('-rotate-45', '-translate-y-[8px]')
          }
        } else {
          // Close menu
          menu.classList.remove('translate-x-0')
          menu.classList.add('translate-x-full')
          
          // Animate to hamburger
          if (spans.length === 3) {
            spans[0]?.classList.remove('rotate-45', 'translate-y-[8px]')
            spans[1]?.classList.remove('opacity-0')
            spans[2]?.classList.remove('-rotate-45', '-translate-y-[8px]')
          }
        }
      })
    }
  })
</script>
