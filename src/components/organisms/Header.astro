---
import LanguageSwitcher from "../molecules/LanguageSwitcher.astro"
import { cn } from "../../lib/utils"
import { getLocalizedPath, getTranslations } from "../../lib/i18n/utils"

const { lang, pageKey } = Astro.props
const t = getTranslations(lang)

const navItems = [
  { key: "home", label: t("global.nav.home") },
  { key: "services", label: t("global.nav.services") },
  { key: "about", label: t("global.nav.about") },
] as const
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href={getLocalizedPath("home", lang)} class="text-xl font-bold text-brand-500">
      EnredArte
    </a>

    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-6 sm:flex">
        {navItems.map((item) => (
          <li>
            <a
              href={getLocalizedPath(item.key, lang)}
              class={cn(
                "text-sm font-medium transition-colors hover:text-brand-500",
                item.key === pageKey ? "text-brand-500" : "text-gray-600",
              )}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <LanguageSwitcher lang={lang} pageKey={pageKey} />
    </div>
  </nav>
</header>
