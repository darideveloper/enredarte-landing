---
import { cn } from "../../lib/utils";
import ImageCard from "../molecules/ImageCard.astro";

export interface ArtworkData {
  src: string;
  alt: string;
  title: string;
  href: string;
  subtitle?: string;
  meta?: string;
  curator?: string;
}

export interface Props {
  artworks: ArtworkData[];
  class?: string;
}

const { artworks, class: className, ...props } = Astro.props;
---

<div class={cn("grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[3px]", className)} {...props}>
  {
    artworks.map((artwork) => (
      <ImageCard
        src={artwork.src}
        alt={artwork.alt}
        title={artwork.title}
        href={artwork.href}
        subtitle={artwork.subtitle}
        meta={artwork.meta}
        curator={artwork.curator}
        class="aspect-[4/5]"
      />
    ))
  }
</div>
