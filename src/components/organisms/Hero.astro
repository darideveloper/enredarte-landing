---
import H1 from '@/components/molecules/H1.astro';
import Headline from '@/components/atoms/Headline.astro';
import ImageBanner from '@/components/molecules/ImageBanner.astro';

export interface Props {
  // We can pass props later if needed, but for now we'll hardcode the content 
  // or accept it via slots as requested.
}
---

<section class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] min-h-[92vh] bg-paper">
  <!-- Left Side: Editorial Content -->
  <div class="flex flex-col justify-center px-6 py-12 lg:px-16 lg:py-0">
    <H1 class="mb-6">
      <Headline color="red" class="block mb-6">Sala 01 — Exhibición del mes</Headline>
      <span class="block leading-[1.03] tracking-[-0.01em]">Tierra, mundo<br/>y <em class="text-crimson font-serif italic">memoria</em></span>
    </H1>
    
    <p class="text-[15px] text-[#7A7568] leading-[1.85] max-w-[420px] mb-10 font-sans">
      Seis artistas contemporáneos exploran el paisaje mexicano como archivo emocional — de los murales urbanos de Guadalajara a la abstracción costera de Los Cabos. Una sala, seis miradas, una sola pregunta: ¿de qué está hecho el lugar al que llamamos hogar?
    </p>
    
    <div class="flex flex-wrap gap-3.5 mb-11">
      <button class="bg-crimson text-paper border-none px-8 py-[15px] text-[11px] tracking-[0.1em] uppercase cursor-pointer transition-opacity hover:opacity-85 font-sans">
        Entrar a la Sala
      </button>
      <button class="bg-transparent text-[#7A7568] border border-[#D8D2C6] px-8 py-[15px] text-[11px] tracking-[0.1em] uppercase cursor-pointer transition-colors hover:border-ink hover:text-ink font-sans">
        Ver Manifiesto
      </button>
    </div>
    
    <div class="text-[11px] text-muted tracking-[0.04em] pt-6 border-t border-border-theme max-w-[420px] font-sans">
      Curaduría por <b class="text-[#4A4A4A] font-semibold">Álvaro Macias</b> — Guadalajara, JAL
    </div>
  </div>

  <!-- Right Side: Featured Artwork -->
  <div class="relative overflow-hidden h-[50vh] lg:h-auto">
    <ImageBanner 
      src="/images/hero-wood-geometry.jpg"
      alt="Obra insignia"
      title="Horizonte en tres tiempos"
      artist="Obra insignia de la sala"
      price="Desde consulta con curador"
      href="/salas/1/obras/1"
      class="w-full h-full"
    />
  </div>
</section>
