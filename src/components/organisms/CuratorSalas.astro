---
import Title from "@/components/atoms/Title.astro"
import Headline from "@/components/atoms/Headline.astro"
import ImageCard from "@/components/molecules/ImageCard.astro"
import { getTranslations } from "@/lib/i18n/utils"
import { cn } from "@/lib/utils"
import type { SalaView } from "@/data/api"
import type { Lang } from "@/lib/api/types"

export interface Props {
  salas: SalaView[]
  lang: Lang
  class?: string
}

const { salas, lang, class: className } = Astro.props
const t = getTranslations(lang)
---

<section id="curator-salas" class={cn("bg-paper px-6 md:px-14 pt-8 md:pt-12 pb-16 md:pb-24 overflow-hidden", className)}>
  <div class="max-w-6xl mx-auto">
    <div class="curator-salas-header mb-8">
      <Title>
        <Headline color="muted" class="block mb-2 tracking-[0.2em]">{t("global.curator.explore")}</Headline>
        {t("global.curator.curatedSalas")}
      </Title>
    </div>

    {salas.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {salas.map((sala) => (
          <ImageCard
            src={sala.src}
            alt={sala.alt}
            title={sala.title}
            href={sala.href}
            subtitle={sala.subtitle}
            meta={sala.meta}
            headingTag="h3"
            class="aspect-[4/3]"
          />
        ))}
      </div>
    ) : (
      <p class="text-muted text-sm italic">{t("global.curator.noSalas")}</p>
    )}
  </div>
</section>
