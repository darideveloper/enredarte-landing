---
import Title from "@/components/atoms/Title.astro"
import Headline from "@/components/atoms/Headline.astro"
import ImageCard from "@/components/molecules/ImageCard.astro"
import { getTranslations } from "@/lib/i18n/utils"
import { IMAGE_SLOTS } from "@/lib/images"
import { cn } from "@/lib/utils"
import type { SalaView } from "@/data/api"
import type { Lang } from "@/lib/api/types"

export interface Props {
  salas: SalaView[]
  lang: Lang
  class?: string
}

const { salas, lang, class: className } = Astro.props
const t = getTranslations(lang)
---

<section id="curator-salas" class={cn("bg-paper container-site-canvas pt-8 md:pt-12 pb-16 md:pb-24 overflow-hidden", className)} transition:animate="none">
  <div class="curator-salas-header js-curador-salas-header mb-8">
    <Title>
      <Headline color="muted" class="block mb-2 tracking-[0.2em]">{t("global.curator.explore")}</Headline>
      {t("global.curator.curatedSalas")}
    </Title>
  </div>

  {salas.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {salas.map((sala) => (
          <ImageCard
            src={sala.src}
            alt={sala.alt}
            title={sala.title}
            href={sala.href}
            subtitle={sala.subtitle}
            meta={sala.meta}
            headingTag="h3"
            widths={IMAGE_SLOTS.grid3.widths}
            sizes={IMAGE_SLOTS.grid3.sizes}
            class="aspect-[4/3] js-curador-sala-card"
          />
        ))}
    </div>
  ) : (
    <p class="text-muted text-sm italic">{t("global.curator.noSalas")}</p>
  )}
</section>

<script>
  import { gsap } from "@/lib/gsap"

  let mm: ReturnType<typeof gsap.matchMedia> | undefined

  const initCuradorSalas = () => {
    const section = document.querySelector("#curator-salas")
    if (!section) return
    mm?.revert()
    mm = gsap.matchMedia()

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const header = section.querySelector(".js-curador-salas-header")
      if (header) {
        gsap.fromTo(
          header,
          { y: 30, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: section,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          }
        )
      }

      const cards = section.querySelectorAll(".js-curador-sala-card")
      if (cards.length > 0) {
        gsap.fromTo(
          cards,
          { y: 40, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.8,
            ease: "power2.out",
            stagger: 0.1,
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: section,
              start: "top 80%",
              toggleActions: "play none none none",
            },
          }
        )
      }
    })

    mm.add("(prefers-reduced-motion: reduce)", () => {
      // no-op: content is visible by default with fromTo+clearProps
    })
  }

  document.addEventListener("astro:after-swap", () => mm?.revert())
  document.addEventListener("astro:page-load", initCuradorSalas)
  initCuradorSalas()
</script>
