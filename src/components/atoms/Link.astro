---
import type { HTMLAttributes } from 'astro/types'
import { cn } from "@/lib/utils"

export interface Props extends HTMLAttributes<'a'> {
  variant?: "default" | "nav"
}

const { class: className, variant = "default", ...props } = Astro.props

const baseStyles = "cursor-pointer"

const variants = {
  default: "text-ink hover:text-crimson transition-colors underline-offset-4 hover:underline",
  nav: "relative pb-1 text-[11px] uppercase tracking-[0.1em] text-muted transition-colors hover:text-ink after:absolute after:left-0 after:bottom-0 after:h-[1px] after:w-0 after:bg-crimson hover:after:w-full after:transition-all after:duration-300"
}
---

<a 
  class={cn(baseStyles, variants[variant], className)} 
  {...props}
>
  <slot />
</a>
