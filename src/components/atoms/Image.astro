---
import { cn } from "../../lib/utils"

export interface Props {
  src: string;
  alt: string;
  aspectRatio?: 'video' | 'square' | '4/5' | 'auto';
  class?: string;
}

const { src, alt, aspectRatio = 'auto', class: className, ...props } = Astro.props;

const aspectClasses = {
  'video': 'aspect-video',
  'square': 'aspect-square',
  '4/5': 'aspect-[4/5]',
  'auto': 'aspect-auto',
};
---

<img 
  src={src} 
  alt={alt} 
  title={alt}
  class={cn("object-cover w-full h-full", aspectClasses[aspectRatio], className)} 
  {...props} 
/>
