---
import { cn } from "@/lib/utils"
import Image from "@/components/atoms/Image.astro"
import { IMAGE_SLOTS } from "@/lib/images"
import logoDefault from "@/assets/logo.png"
import logoDark from "@/assets/logo-dark.png"
import logoLight from "@/assets/logo-light.png"
import logoBgRed from "@/assets/logo-bg-red.png"
import logoBgRedCircle from "@/assets/logo-bg-red-circle.webp"

export interface Props {
  variant?: "default" | "dark" | "light" | "bg-red" | "bg-red-circle" | "icon"
  alt?: string
  href?: string
  class?: string
}

const logoVariants = {
  default: logoDefault,
  dark: logoDark,
  light: logoLight,
  "bg-red": logoBgRed,
  "bg-red-circle": logoBgRedCircle,
  icon: "/favicon.svg",
}

const {
  variant = "default",
  alt = "enredarte logo",
  href = "/",
  class: className,
} = Astro.props

const imageSrc = logoVariants[variant]
const isIcon = variant === "icon"
---

<a href={href} class={"inline-block transition-opacity hover:opacity-90"}>
  {isIcon ? (
    <img
      src={imageSrc}
      alt={alt}
      class={cn("w-auto object-contain", className)}
      loading="eager"
    />
  ) : (
    <Image
      src={imageSrc}
      alt={alt}
      loading="eager"
      decoding="async"
      fetchpriority="low"
      widths={IMAGE_SLOTS.logo.widths}
      sizes={IMAGE_SLOTS.logo.sizes}
      class={cn("w-auto object-contain", className)}
    />
  )}
</a>
