---
import { cn } from "@/lib/utils"

export interface Props {
  title: string
  href: string
  subtitle?: string
  meta?: string
  curator?: string
  price?: string
  class?: string
}

const { title, href, subtitle, meta, curator, price, class: className, ...props } = Astro.props
---

<a
  href={href}
  class={cn("absolute inset-0 flex flex-col justify-end p-7 z-10", className)}
  {...props}
>
  {
    subtitle && (
      <p class="text-[10px] uppercase text-crimson font-bold tracking-[0.2em] mb-2.5 drop-shadow-[0_1px_3px_rgba(0,0,0,0.95)]">
        {subtitle}
      </p>
    )
  }
  <div class="relative pl-0 group-hover:pl-3.5 transition-all duration-300 ease-out">
    <span class="absolute left-0 top-1.5 bottom-3.5 w-[3px] bg-crimson rounded-full opacity-0 -translate-x-2 scale-y-75 group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-y-100 transition-all duration-300 ease-out" />
    <h2 class="font-serif text-paper leading-[1.15] mb-2 text-[26px]">
      {title}
    </h2>
  </div>
  {
    meta && (
      <p class="text-[10px] text-[#CCC] tracking-[0.06em] uppercase">
        {meta}
      </p>
    )
  }
  {
    curator && (
      <p class="text-[10px] text-[#999] italic mt-1.5">
        {curator}
      </p>
    )
  }
  {
    price && (
      <p class="text-[11px] text-paper tracking-[0.06em] font-sans font-medium mt-1.5">
        {price}
      </p>
    )
  }
</a>
