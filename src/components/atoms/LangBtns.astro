---
import { getLangFromUrl, getLocalizedPath, getPageKeyFromUrl } from "@/lib/i18n/utils"
import { cn } from "@/lib/utils"
import type { Lang } from "@/lib/api/types"

export interface Props {
  lang?: Lang
  pageKey?: string
  localizedPaths?: Record<Lang, string>
  class?: string
  variant?: "default" | "inverse"
}

const { class: className, variant = "default", localizedPaths } = Astro.props
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url)
const pageKey = Astro.props.pageKey ?? getPageKeyFromUrl(Astro.url)

const variantStyles = {
  default: {
    active: "text-ink font-semibold pointer-events-none",
    inactive: "text-muted hover:text-ink",
    separator: "text-border-theme",
  },
  inverse: {
    active: "text-paper font-semibold pointer-events-none",
    inactive: "text-paper/60 hover:text-paper",
    separator: "text-paper/40",
  },
}

const styles = variantStyles[variant]

const languages: { code: Lang; label: string }[] = [
  { code: "es", label: "ES" },
  { code: "en", label: "EN" },
]
---

<div class={cn("flex items-center gap-1.5 text-[10px] tracking-[0.1em] uppercase font-sans", className)}>
  {
    languages.map((l, idx) => {
      const isActive = l.code === lang
      const url = localizedPaths?.[l.code] ?? getLocalizedPath(pageKey, l.code)

      return (
        <>
          {idx > 0 && <span class={cn("font-sans", styles.separator)}>/</span>}
          <a
            href={url}
            class={cn("transition-colors duration-200", isActive ? styles.active : styles.inactive)}
          >
            {l.label}
          </a>
        </>
      )
    })
  }
</div>
