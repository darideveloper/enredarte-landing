---
import { renderMarkdown } from "@/lib/markdown"

export interface Props {
  content?: string | null
  class?: string
  variant?: "default" | "compact" | "on-dark"
  dropcap?: boolean
  copyLabel?: string
  copiedLabel?: string
  videoTitle?: string
}

const { content, class: className, variant = "default", dropcap = false, copyLabel, copiedLabel, videoTitle } = Astro.props
const html = renderMarkdown(content ?? "", { copyLabel, copiedLabel, videoTitle })
// Element styling lives in plain CSS (`global.css` `.markdown-prose` /
// `.blog-prose`): the repo ships no `@tailwindcss/typography`, so `prose-*`
// classes generate no rules. Only real utilities stay in this string.
const prose = "hyphens-auto"
---

<div
  class:list={["markdown-prose", prose, variant !== "default" && `markdown-prose--${variant}`, dropcap && "markdown-prose--dropcap", className]}
  set:html={html}
/>

<script>
  import { attachCodeCopy } from "@/lib/code-copy"
  attachCodeCopy()
  document.addEventListener("astro:page-load", () => attachCodeCopy())
</script>
