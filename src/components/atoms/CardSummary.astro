---
import { cn } from "@/lib/utils"
import { formatPrice, pickPrice, currencyForLang } from "@/lib/format/price"
import type { Lang } from "@/lib/api/types"

export interface Props {
    title: string
    href: string
    artist?: string
    priceMxn?: number
    priceUsd?: number
    lang: Lang
    priceFallback?: string
    class?: string
}

const { title, href, artist, priceMxn, priceUsd, lang, priceFallback, class: className, ...props } = Astro.props
const price = formatPrice(pickPrice(priceMxn, priceUsd, currencyForLang(lang)), currencyForLang(lang)) || priceFallback
---

<a
    href={href}
    class={cn(
        "block bg-black/88 backdrop-blur-sm p-4 md:p-5 max-w-[260px] group transition-all duration-300 ease-out hover:bg-black/95 hover:scale-[1.03] hover:-translate-y-1 hover:shadow-2xl",
        className,
    )}
    {...props}
>
    <h2 class="font-serif text-base text-paper mb-1 leading-snug">{title}</h2>
    {
        artist && (
            <p class="text-[10px] text-muted tracking-wider uppercase mb-2.5 font-sans">
                {artist}
            </p>
        )
    }
    {price && <p class="text-sm text-crimson font-sans font-medium">{price}</p>}
</a>
