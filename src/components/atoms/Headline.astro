---
import type { HTMLAttributes } from 'astro/types'
import { cn } from "@/lib/utils"

export interface Props extends HTMLAttributes<'span'> {
  color?: "red" | "default" | "muted"
}

const { class: className, color = "red", ...props } = Astro.props

const baseStyles = "uppercase tracking-[0.22em] text-[10px]"

const colorStyles = {
  red: "text-crimson",
  default: "text-ink",
  muted: "text-muted"
}
---

<span class={cn(baseStyles, colorStyles[color], className)} {...props}>
  <slot />
</span>
