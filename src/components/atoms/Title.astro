---
import { cn } from "../../lib/utils";

export interface Props {
  linkText?: string;
  linkHref?: string;
  class?: string;
}

const { linkText, linkHref, class: className, ...props } = Astro.props;
---

<div class={cn("flex flex-col sm:flex-row justify-between items-start sm:items-baseline gap-2 sm:gap-0 mb-10", className)} {...props}>
  <h2 class="font-serif text-3xl text-ink">
    <slot />
  </h2>
  {
    linkText && linkHref && (
      <a 
        href={linkHref} 
        class="text-[11px] text-crimson tracking-[0.06em] hover:underline"
      >
        {linkText}
      </a>
    )
  }
</div>
