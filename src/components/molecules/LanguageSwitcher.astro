---
import { languages } from "../../lib/i18n/ui"
import { getLocalizedPath } from "../../lib/i18n/utils"

const { lang, pageKey } = Astro.props
const targetLang = lang === "en" ? "es" : "en"
const targetUrl = getLocalizedPath(pageKey, targetLang)
---

<a
  href={targetUrl}
  class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900"
>
  {languages[targetLang]}
</a>
