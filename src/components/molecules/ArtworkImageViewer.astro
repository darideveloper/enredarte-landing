---
import Image from "@/components/atoms/Image.astro"
import type { ArtworkDetailView } from "@/data/api"

export interface Props {
  artwork: ArtworkDetailView
}

const { artwork } = Astro.props
const { images } = artwork
const multi = images.length > 1
---

<div class="artwork-viewer h-full" data-count={images.length}>
  {images.length === 0 ? (
    <p class="flex h-full items-center justify-center text-muted font-sans text-sm">—</p>
  ) : multi ? (
    <div class="artwork-images relative overflow-hidden bg-[#0D0D0D] h-full" data-scrub>
      {images.map((image, i) => (
        <div
          class="artwork-image absolute inset-0"
          style={i === 0 ? undefined : { opacity: 0, visibility: "hidden" }}
        >
          <Image src={image.src} alt={image.alt} class="w-full h-full object-cover" />
        </div>
      ))}
      {images.length > 1 && (
        <span class="artwork-counter absolute bottom-6 right-6 z-10 bg-paper/90 px-4 py-2 text-[10px] uppercase tracking-[0.14em] font-sans text-ink">
          1 / {images.length}
        </span>
      )}
    </div>
  ) : (
    <div class="overflow-hidden bg-[#0D0D0D] h-full">
      <Image src={images[0].src} alt={images[0].alt} class="w-full h-full object-cover" />
    </div>
  )}
</div>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap"

  let mm: gsap.MatchMedia | undefined

  const initScrub = () => {
    const viewer = document.querySelector<HTMLElement>(".artwork-viewer[data-count]")
    if (!viewer) return
    const count = Number(viewer.dataset.count)
    if (!(count > 1)) return

    const section = viewer.closest<HTMLElement>("[data-scroll-section]")
    const images = viewer.querySelectorAll<HTMLElement>(".artwork-image")
    const counter = viewer.querySelector<HTMLElement>(".artwork-counter")
    if (!section || images.length < 2) return

    mm?.revert()
    mm = gsap.matchMedia()

    mm.add("(min-width: 1024px) and (prefers-reduced-motion: no-preference)", () => {
      const tl = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: section,
          start: "top 80px",
          end: () => `+=${(images.length - 1) * 100}%`,
          pin: true,
          scrub: 1,
          onUpdate: (self) => {
            if (counter) {
              const idx = Math.min(Math.floor(self.progress * images.length), images.length - 1) + 1
              counter.textContent = `${idx} / ${images.length}`
            }
          },
        },
      })

      images.forEach((img, i) => {
        if (i === 0) return
        tl.to(
          img,
          { opacity: 1, visibility: "visible", duration: 1 },
          i === 1 ? 0 : `+=0.05`,
        )
      })

      return () => {
        tl.kill()
        ScrollTrigger.getAll().forEach((st) => {
          if (st.vars.trigger === section) st.kill()
        })
        images.forEach((img, i) => {
          if (i === 0) return
          gsap.set(img, { opacity: 0, visibility: "hidden", clearProps: "all" })
        })
        if (counter) counter.textContent = `1 / ${images.length}`
      }
    })

    mm.add("(prefers-reduced-motion: reduce), (max-width: 1023px)", () => {
      const stack = viewer.querySelector<HTMLElement>(".artwork-images")
      stack?.classList.add("is-stacked")
      images.forEach((img, i) => {
        if (i === 0) return
        gsap.set(img, { opacity: 1, visibility: "visible" })
      })
      if (counter) counter.textContent = `${images.length} / ${images.length}`

      return () => {
        stack?.classList.remove("is-stacked")
      }
    })

    ScrollTrigger.refresh()
  }

  document.addEventListener("astro:after-swap", () => mm?.revert())
  document.addEventListener("astro:page-load", initScrub)
</script>

<style>
  .artwork-viewer {
    min-height: 60vh;
  }

  @media (min-width: 1024px) {
    .artwork-viewer {
      min-height: 100vh;
    }
  }

  .artwork-images.is-stacked {
    display: flex;
    flex-direction: column;
    aspect-ratio: auto;
  }

  .artwork-images.is-stacked .artwork-image {
    position: static;
    height: auto;
    visibility: visible;
    opacity: 1;
  }

  .artwork-images.is-stacked .artwork-image :global(img) {
    aspect-ratio: 4/5;
  }
</style>
