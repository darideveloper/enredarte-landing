---
import Image from '@/components/atoms/Image.astro';
import CardSummary from '@/components/atoms/CardSummary.astro';
import { cn } from "@/lib/utils"

export interface Props {
  // Image props
  src: string;
  alt: string;
  aspectRatio?: 'square' | 'video' | 'portrait' | 'auto';
  
  // Card summary props
  title: string;
  href: string;
  artist?: string;
  price?: string;
  
  // Overlay props
  overlay?: 'hover' | 'darker' | 'always' | 'none';
  darkenOnHover?: boolean;

  // Container props
  class?: string;
}

const { 
  src, 
  alt, 
  aspectRatio = 'auto',
  title, 
  href, 
  artist, 
  price,
  overlay = 'hover',
  darkenOnHover,
  class: className,
  ...props 
} = Astro.props;

const overlayMode = darkenOnHover !== undefined ? (darkenOnHover ? 'hover' : 'none') : overlay;

const overlayStyles = {
  hover: "bg-gradient-to-t from-black/65 via-black/25 to-transparent group-hover:from-black/90 group-hover:via-black/50 transition-all duration-300",
  darker: "bg-gradient-to-t from-black/85 via-black/50 to-black/20 transition-all duration-300",
  always: "bg-black/40 transition-all duration-300",
  none: "",
};
---

<div class={cn("relative overflow-hidden group", className)} {...props}>
  <Image 
    src={src} 
    alt={alt} 
    title={alt}
    aspectRatio={aspectRatio}
    class="w-full h-full object-cover"
  />
  
  {overlayMode !== 'none' && (
    <div class={cn("absolute inset-0 pointer-events-none z-[1]", overlayStyles[overlayMode])} />
  )}
  
  <div class="absolute bottom-0 left-0 p-4 md:p-6 lg:p-8 w-full flex items-end z-10">
    <CardSummary 
      title={title}
      href={href}
      artist={artist}
      price={price}
    />
  </div>
</div>
