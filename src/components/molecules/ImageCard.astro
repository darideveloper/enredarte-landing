---
import { cn } from "../../lib/utils";
import Image from "../atoms/Image.astro";
import CardInfo from "./CardInfo.astro";

export interface Props {
  src: string;
  alt: string;
  title: string;
  href: string;
  isLarge?: boolean;
  subtitle?: string;
  meta?: string;
  curator?: string;
  class?: string;
}

const { src, alt, title, href, isLarge = false, subtitle, meta, curator, class: className, ...props } = Astro.props;
---

<div class={cn(
  "relative overflow-hidden cursor-pointer bg-[#0D0D0D] group h-full w-full",
  isLarge && "md:col-span-2 md:row-span-2 lg:col-span-1",
  className
)} {...props}>
  <Image 
    src={src} 
    alt={alt} 
    class="transition-all duration-[6s] ease-out group-hover:scale-105 group-hover:brightness-[0.42] group-hover:saturate-100 brightness-[0.62] saturate-[0.9] absolute inset-0 w-full h-full object-cover"
  />
  <CardInfo
    title={title}
    href={href}
    subtitle={subtitle}
    meta={meta}
    curator={curator}
    class={cn(isLarge && "[&>h2]:text-[32px]")}
  />
</div>
