---
import { cn } from "@/lib/utils"
import Image from "@/components/atoms/Image.astro"
import CardInfo from "@/components/atoms/CardInfo.astro"

export interface Props {
  src: string
  alt: string
  title: string
  href: string
  isLarge?: boolean
  subtitle?: string
  meta?: string
  curator?: string
  price?: string
  overlay?: 'hover' | 'darker' | 'always' | 'none'
  darkenOnHover?: boolean
  class?: string
}

const {
  src,
  alt,
  title,
  href,
  isLarge = false,
  subtitle,
  meta,
  curator,
  price,
  overlay = 'hover',
  darkenOnHover,
  class: className,
  ...props
} = Astro.props

const overlayMode = darkenOnHover !== undefined ? (darkenOnHover ? 'hover' : 'none') : overlay

const overlayStyles = {
  hover: "bg-gradient-to-t from-black/80 via-black/40 to-transparent group-hover:from-black/95 group-hover:via-black/60 transition-all duration-500",
  darker: "bg-gradient-to-t from-black/90 via-black/60 to-black/30 transition-all duration-500",
  always: "bg-black/50 transition-all duration-500",
  none: "",
}
---

<div class={cn(
  "relative overflow-hidden cursor-pointer bg-[#0D0D0D] group h-full w-full",
  isLarge && "md:col-span-2 md:row-span-2 lg:col-span-1",
  className
)} {...props}>
  <Image 
    src={src} 
    alt={alt} 
    class="transition-all duration-500 ease-out group-hover:scale-105 brightness-[0.75] group-hover:brightness-[0.55] absolute inset-0 w-full h-full object-cover"
  />
  
  {overlayMode !== 'none' && (
    <div class={cn("absolute inset-0 pointer-events-none z-[1]", overlayStyles[overlayMode])} />
  )}

  <CardInfo
    title={title}
    href={href}
    subtitle={subtitle}
    meta={meta}
    curator={curator}
    price={price}
    class={cn(isLarge && "[&>h2]:text-[32px]")}
  />
</div>
