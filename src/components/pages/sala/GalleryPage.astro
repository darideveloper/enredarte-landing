---
import PageSEO from "@/components/seo/PageSEO.astro"
import Title from "@/components/atoms/Title.astro"
import Headline from "@/components/atoms/Headline.astro"
import Image from "@/components/atoms/Image.astro"
import { Filters } from "@/components/molecules/Filters"
import { Artworks } from "@/components/organisms/Artworks"
import ImageRowCard from "@/components/molecules/ImageRowCard.astro"
import CuratorCard from "@/components/molecules/CuratorCard.astro"
import {
  getFacetLabel,
  resolveArtistName,
  resolveGalleryArtworks,
  resolveGalleryCurator,
  toArtworkView,
} from "@/data/api"
import type { SiteData } from "@/data/api"
import { getTranslations, pickTranslation, getLocalizedSalaPath } from "@/lib/i18n/utils"
import type { Lang } from "@/lib/api/types"

export interface Props {
  lang: Lang
  gallerySlug: string
  siteData: SiteData
}

const { lang, gallerySlug, siteData } = Astro.props
const t = getTranslations(lang)

const gallery = siteData.galleries.find((g) => g.slug === gallerySlug)
if (!gallery) {
  throw new Error(`Unknown gallery slug: ${gallerySlug}`)
}

const curator = resolveGalleryCurator(gallery, siteData.curators)
const galleryArtworks = resolveGalleryArtworks(gallery, siteData.artworks)
const artworks = galleryArtworks.map((artwork) =>
  toArtworkView(artwork, resolveArtistName(artwork.artist, siteData.artists), lang, siteData.filterGroups)
)

const localizedGroups = siteData.filterGroups
  .filter((group) => group.key === "artist" || group.key === "technique")
  .map((group) => ({
    key: group.key,
    label: group.label[lang],
    options: group.options.map((option) => ({ value: option.value, label: option.label[lang] })),
  }))

const facets = artworks.map(({ artist, discipline, technique, theme, format, scale }) => ({
  artist,
  discipline,
  technique,
  theme,
  format,
  scale,
}))

const [featured] = artworks
const galleryIndex = siteData.galleries.findIndex((g) => g.slug === gallery.slug)
const eyebrow = `${t("global.gallery.sala")} ${String(galleryIndex + 1).padStart(2, "0")}`
const galleryName = pickTranslation(gallery.translations, lang, "name") || gallery.slug
const galleryDescription = pickTranslation(gallery.translations, lang, "description")
const heroSrc = gallery.logo ?? featured?.src ?? ""
const alternateUrls = {
  en: getLocalizedSalaPath(gallery.slug, "en"),
  es: getLocalizedSalaPath(gallery.slug, "es"),
}
---

<PageSEO
  lang={lang}
  title={galleryName}
  description={galleryDescription}
  ogImage={gallery.logo ?? featured?.src}
  alternateUrls={alternateUrls}
  slot="seo"
/>

<section class="bg-paper overflow-hidden pt-16 md:pt-24" transition:animate="none">
  <div class="max-w-6xl px-6 md:px-14 mb-10 md:mb-14">
    <Headline color="muted" class="block mb-3 tracking-[0.2em]">{eyebrow}</Headline>
    <h1 class="font-serif text-4xl md:text-5xl text-ink leading-[1.1] mb-6">{galleryName}</h1>
    <p class="text-[15px] text-description leading-[1.85] max-w-[560px]">{galleryDescription}</p>
  </div>
  <div class="relative h-[55svh] md:h-[75svh] overflow-hidden bg-[#0D0D0D]">
    <Image src={heroSrc} alt={galleryName} class="absolute inset-0 w-full h-full object-cover" />
  </div>
</section>

{curator && (
  <section class="bg-paper px-6 md:px-14 py-16 md:py-24 overflow-hidden" transition:animate="none">
    <CuratorCard curator={curator} lang={lang} />
  </section>
)}

<section id="sala-artworks" class="bg-paper pt-16 md:pt-24 pb-16 md:pb-24">
  <div class="max-w-6xl px-6 md:px-14 mb-10">
    <Title>
      <Headline color="muted" class="block mb-2 tracking-[0.2em]">Explora</Headline>
      {t("global.gallery.works")}
    </Title>
  </div>

  <div class="max-w-6xl px-6 md:px-14">
    <Filters
      client:load
      groups={localizedGroups}
      facets={facets}
      expandLabel={t("global.filters.more")}
      collapseLabel={t("global.filters.less")}
    />
  </div>

  <Artworks
    client:load
    loadingLabel={t("global.loading")}
    emptyLabel={t("global.filters.noResults")}
    resetLabel={t("global.filters.reset")}
    gridClassName="grid-cols-1"
  >
    {artworks.map((artwork, i) => (
      <ImageRowCard
        artwork={artwork}
        lang={lang}
        tags={[
          getFacetLabel("discipline", artwork.discipline[0] ?? "", lang, siteData.filterGroups),
          getFacetLabel("technique", artwork.technique[0] ?? "", lang, siteData.filterGroups),
          getFacetLabel("theme", artwork.theme[0] ?? "", lang, siteData.filterGroups),
        ]}
        reverse={i % 2 === 1}
        immersive
        data-artist={artwork.artist.join(" ")}
        data-discipline={artwork.discipline.join(" ")}
        data-technique={artwork.technique.join(" ")}
        data-theme={artwork.theme.join(" ")}
        data-format={artwork.format.join(" ")}
        data-scale={artwork.scale.join(" ")}
      />
    ))}
  </Artworks>
</section>