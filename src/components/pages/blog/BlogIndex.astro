---
import PageSEO from "@/components/seo/PageSEO.astro"
import PostCard from "@/components/pages/blog/PostCard.astro"
import PaginationNav from "@/components/molecules/PaginationNav.astro"
import Headline from "@/components/atoms/Headline.astro"
import Btn from "@/components/atoms/Btn.astro"
import { getLocalizedPostPath, getLocalizedBlogPagePath, getLocalizedBlogPath } from "@/lib/i18n/utils"
import { getTranslations } from "@/lib/i18n/utils"
import { renderInline } from "@/lib/markdown"
import type { Lang, PostSummary } from "@/lib/api/types"

export interface Props {
  lang: Lang
  posts: PostSummary[]
  pagination: { page: number; total_pages: number; count: number }
}

const { lang, posts, pagination } = Astro.props
const t = getTranslations(lang)

const pageTitle = t("pages.blog.title")
const eyebrow = t("pages.blog.eyebrow")
const pageDescription = t("pages.blog.description")
const pageKeywords = t("pages.blog.keywords")

const alternateUrls = {
  en: getLocalizedBlogPagePath(pagination.page, "en"),
  es: getLocalizedBlogPagePath(pagination.page, "es"),
}

const hasFeatured = posts.length > 1
const featuredPost = hasFeatured ? posts[0] : null
const gridPosts = hasFeatured ? posts.slice(1) : posts
---

<PageSEO
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  alternateUrls={alternateUrls}
  slot="seo"
/>

<section class="bg-paper js-blog-section" transition:animate="none">
  <!-- Header: eyebrow + title + description (Eyebrow Rule) -->
  <div class="container-site-canvas pt-16 md:pt-24 pb-10 md:pb-14">
    <div class="max-w-[720px] js-blog-header">
      <Headline color="red" class="mb-3 block">{eyebrow}</Headline>
      <h1 class="font-serif text-[42px] md:text-[56px] leading-[0.95] tracking-[-0.02em] text-ink text-balance mb-4">
        {pageTitle}
      </h1>
      <p class="text-[15px] leading-[1.8] text-description max-w-[560px] text-pretty" set:html={renderInline(pageDescription)} />
      {pagination.count > 0 && (
        <p class="mt-6 text-[11px] uppercase tracking-[0.14em] text-muted">
          {pagination.count} {pagination.count === 1 ? "artículo" : "artículos"} — {t("pages.blog.pagination.page", { current: String(pagination.page), total: String(Math.max(pagination.total_pages,1)) })}
        </p>
      )}
    </div>
    <!-- hairline -->
    <div class="mt-8 h-px bg-border-theme w-full"></div>
  </div>

  {pagination.count === 0 ? (
    <div class="container-site-canvas pb-16 md:pb-24">
      <div class="js-blog-empty border border-border-theme bg-white/40 px-8 py-16 md:py-20 text-center">
        <Headline color="muted" class="mb-3 block">{eyebrow}</Headline>
        <h2 class="font-serif text-2xl md:text-3xl text-ink mb-3">{t("pages.blog.noPosts")}</h2>
        <p class="text-[14px] leading-relaxed text-description max-w-[44ch] mx-auto mb-8" set:html={renderInline(t("pages.blog.noPostsHint"))} />
        <Btn variant="ghost" href={getLocalizedBlogPath(lang)}>{t("pages.blog.backToBlog")}</Btn>
      </div>
    </div>
  ) : (
    <div class="container-site-canvas pb-16 md:pb-24">
      <!-- Mosaic grid: 3px gap on desktop per DESIGN gallery mosaic, 16px on mobile -->
      <div class="js-blog-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-[3px] auto-rows-fr">
        {featuredPost && (
          <PostCard post={featuredPost} lang={lang} href={getLocalizedPostPath(featuredPost.slug, lang)} featured class="js-blog-card" />
        )}
        {gridPosts.map((post) => (
          <PostCard post={post} lang={lang} href={getLocalizedPostPath(post.slug, lang)} class="js-blog-card" />
        ))}
      </div>

      <div class="js-blog-pagination">
        <PaginationNav page={pagination.page} total_pages={pagination.total_pages} lang={lang} />
      </div>
    </div>
  )}
</section>

<script>
  import { gsap } from "@/lib/gsap"

  let mm: ReturnType<typeof gsap.matchMedia> | undefined

  const initBlogIndex = () => {
    const section = document.querySelector(".js-blog-section")
    if (!section) return
    mm?.revert()
    mm = gsap.matchMedia()

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const header = section.querySelector(".js-blog-header")
      if (header) {
        gsap.fromTo(
          header,
          { y: 30, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: section,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          }
        )
      }

      const cards = section.querySelectorAll(".js-blog-card")
      if (cards.length > 0) {
        gsap.fromTo(
          cards,
          { y: 40, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.8,
            ease: "power2.out",
            stagger: 0.1,
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: section.querySelector(".js-blog-grid") ?? section,
              start: "top 80%",
              toggleActions: "play none none none",
            },
          }
        )
      }

      const pagination = section.querySelector(".js-blog-pagination")
      const empty = section.querySelector(".js-blog-empty")
      const footers: Element[] = [pagination, empty].filter((el): el is Element => el !== null)
      footers.forEach((el) => {
        gsap.fromTo(
          el,
          { y: 20, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: el,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          }
        )
      })
    })

    mm.add("(prefers-reduced-motion: reduce)", () => {
      // no-op: content is visible by default with fromTo+clearProps
    })
  }

  document.addEventListener("astro:after-swap", () => mm?.revert())
  document.addEventListener("astro:page-load", initBlogIndex)
  initBlogIndex()
</script>
