---
import PageSEO from "@/components/seo/PageSEO.astro"
import PostCard from "@/components/pages/blog/PostCard.astro"
import PaginationNav from "@/components/molecules/PaginationNav.astro"
import Headline from "@/components/atoms/Headline.astro"
import Btn from "@/components/atoms/Btn.astro"
import { getLocalizedPostPath, getLocalizedBlogPagePath, getLocalizedBlogPath } from "@/lib/i18n/utils"
import { getTranslations } from "@/lib/i18n/utils"
import type { Lang, PostSummary } from "@/lib/api/types"

export interface Props {
  lang: Lang
  posts: PostSummary[]
  pagination: { page: number; total_pages: number; count: number }
}

const { lang, posts, pagination } = Astro.props
const t = getTranslations(lang)

const pageTitle = t("pages.blog.title")
const eyebrow = t("pages.blog.eyebrow")
const pageDescription = t("pages.blog.description")
const pageKeywords = t("pages.blog.keywords")

const alternateUrls = {
  en: getLocalizedBlogPagePath(pagination.page, "en"),
  es: getLocalizedBlogPagePath(pagination.page, "es"),
}

const hasFeatured = posts.length > 1
const featuredPost = hasFeatured ? posts[0] : null
const gridPosts = hasFeatured ? posts.slice(1) : posts
---

<PageSEO
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  alternateUrls={alternateUrls}
  slot="seo"
/>

<section class="bg-paper" transition:animate="none">
  <!-- Header: eyebrow + title + description (Eyebrow Rule) -->
  <div class="max-w-6xl px-6 md:px-14 pt-16 md:pt-24 pb-10 md:pb-14">
    <div class="max-w-[720px]">
      <Headline color="red" class="mb-3 block">{eyebrow}</Headline>
      <h1 class="font-serif text-[42px] md:text-[56px] leading-[0.95] tracking-[-0.02em] text-ink text-balance mb-4">
        {pageTitle}
      </h1>
      <p class="text-[15px] leading-[1.8] text-description max-w-[560px] text-pretty">
        {pageDescription}
      </p>
      {pagination.count > 0 && (
        <p class="mt-6 text-[11px] uppercase tracking-[0.14em] text-muted">
          {pagination.count} {pagination.count === 1 ? "artículo" : "artículos"} — {t("pages.blog.pagination.page", { current: String(pagination.page), total: String(Math.max(pagination.total_pages,1)) })}
        </p>
      )}
    </div>
    <!-- hairline -->
    <div class="mt-8 h-px bg-border-theme w-full"></div>
  </div>

  {pagination.count === 0 ? (
    <div class="max-w-6xl px-6 md:px-14 pb-16 md:pb-24">
      <div class="border border-border-theme bg-white/40 px-8 py-16 md:py-20 text-center">
        <Headline color="muted" class="mb-3 block">{eyebrow}</Headline>
        <h2 class="font-serif text-2xl md:text-3xl text-ink mb-3">{t("pages.blog.noPosts")}</h2>
        <p class="text-[14px] leading-relaxed text-description max-w-[44ch] mx-auto mb-8">{t("pages.blog.noPostsHint")}</p>
        <Btn variant="ghost" href={getLocalizedBlogPath(lang)}>{t("pages.blog.backToBlog")}</Btn>
      </div>
    </div>
  ) : (
    <div class="max-w-6xl px-6 md:px-14 pb-16 md:pb-24">
      <!-- Mosaic grid: 3px gap on desktop per DESIGN gallery mosaic, 16px on mobile -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-[3px] auto-rows-fr">
        {featuredPost && (
          <PostCard post={featuredPost} lang={lang} href={getLocalizedPostPath(featuredPost.slug, lang)} featured />
        )}
        {gridPosts.map((post) => (
          <PostCard post={post} lang={lang} href={getLocalizedPostPath(post.slug, lang)} />
        ))}
      </div>

      <PaginationNav page={pagination.page} total_pages={pagination.total_pages} lang={lang} />
    </div>
  )}
</section>

<style>
  /* single authored entrance: cards fade + lift once, respects reduced-motion */
  @media (prefers-reduced-motion: no-preference) {
    section :global(.group) {
      animation: blog-enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i, 0) * 40ms);
    }
  }
  @keyframes blog-enter {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
