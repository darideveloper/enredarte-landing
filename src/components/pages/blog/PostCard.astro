---
import { pickPostField } from "@/lib/api/posts"
import { getTranslations } from "@/lib/i18n/utils"
import type { Lang, PostSummary } from "@/lib/api/types"

export interface Props {
  post: PostSummary
  lang: Lang
  href: string
  featured?: boolean
}

const { post, lang, href, featured = false } = Astro.props

const title = pickPostField(post, lang, "title")
const description = pickPostField(post, lang, "description")
const t = getTranslations(lang)
const bannerSrc = post.banner_image ?? null

let formattedDate = ""
if (post.published_at) {
  try {
    const d = new Date(post.published_at)
    formattedDate = new Intl.DateTimeFormat(lang === "es" ? "es-ES" : "en-US", {
      day: "numeric",
      month: "short",
      year: "numeric",
    }).format(d)
  } catch {
    formattedDate = ""
  }
}
const meta = formattedDate ? `${post.author} • ${formattedDate}` : post.author
---

<a
  href={href}
  class:list={[
    "group relative flex flex-col h-full bg-card-dark overflow-hidden cursor-pointer",
    "border border-transparent hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 ease-out",
    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-paper",
    featured ? "lg:col-span-2" : "",
  ]}
>
  {bannerSrc ? (
    <div class:list={["relative overflow-hidden bg-card-dark", featured ? "flex-1 min-h-0 w-full aspect-[16/10]" : "shrink-0 aspect-[4/3]"]}>
      <img
        src={bannerSrc}
        alt={title}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-[1.05] brightness-[0.92] group-hover:brightness-[0.72]"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent opacity-90 group-hover:from-black/85 group-hover:via-black/35 transition-all duration-500" />
      <!-- date badge -->
      {formattedDate && (
        <span class="absolute top-3 left-3 bg-paper/90 backdrop-blur-sm text-ink text-[9px] uppercase tracking-[0.16em] font-sans px-2.5 py-1.5">
          {formattedDate}
        </span>
      )}
      <!-- title overlay for featured to use larger type -->
      {featured && (
        <div class="absolute inset-x-0 bottom-0 flex flex-col justify-end p-6 md:p-8 pt-12">
          <p class="text-[10px] uppercase tracking-[0.2em] text-paper/70 mb-2 font-sans">{post.author}</p>
          <h3 class="font-serif text-paper leading-[1.1] text-[28px] md:text-[32px] text-balance mb-3 group-hover:text-paper transition-colors">{title}</h3>
          {description && (
            <p class="text-[13px] text-paper/80 leading-relaxed line-clamp-2 max-w-[48ch]">{description}</p>
          )}
          <span class="inline-flex items-center gap-2 mt-4 text-[10px] uppercase tracking-[0.14em] text-paper border border-paper/30 px-3 py-2 group-hover:bg-paper group-hover:text-ink group-hover:border-paper transition-all duration-300">
            {t("pages.blog.readMore")} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </div>
      )}
    </div>
  ) : (
    <div class:list={["relative bg-card-dark flex flex-col", featured ? "min-h-[320px] p-8 justify-end" : "aspect-[4/3] p-6 justify-end"]}>
      <div class="absolute inset-0 bg-gradient-to-br from-ink via-card-dark to-ink opacity-95" />
      <div class="absolute top-0 right-0 w-24 h-24 bg-crimson/20 blur-3xl" />
      <div class="relative">
        <p class="text-[10px] uppercase tracking-[0.2em] text-paper/60 mb-3">{meta}</p>
        <h3 class:list={["font-serif text-paper leading-tight mb-3", featured ? "text-[28px] md:text-[32px]" : "text-[22px]"]}>{title}</h3>
        {description && <p class="text-[13px] text-paper/70 leading-relaxed line-clamp-3">{description}</p>}
      </div>
    </div>
  )}

  {!featured && (
    <div class="relative bg-paper p-5 md:p-6 flex flex-col flex-1">
      <!-- crimson accent bar -->
      <span class="absolute left-0 top-5 bottom-5 w-[2px] bg-crimson rounded-full opacity-0 -translate-x-1 scale-y-75 group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-y-100 transition-all duration-300 ease-out will-change-transform" aria-hidden="true"></span>
      <div class="transition-transform duration-300 ease-out will-change-transform group-hover:translate-x-3 flex flex-col flex-1">
        <h3 class="font-serif text-[20px] leading-[1.2] text-ink text-balance mb-2 group-hover:text-crimson transition-colors duration-300 line-clamp-2 min-h-[48px]">{title}</h3>
        {description && (
          <p class="text-[13px] text-description leading-relaxed line-clamp-2 mb-3">{description}</p>
        )}
        <p class="text-[10px] tracking-[0.14em] uppercase text-muted font-sans mt-auto pt-3">{meta}</p>
      </div>
    </div>
  )}
</a>
