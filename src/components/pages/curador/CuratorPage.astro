---
import PageSEO from "@/components/seo/PageSEO.astro"
import CuratorHero from "@/components/organisms/CuratorHero.astro"
import CuratorSalas from "@/components/organisms/CuratorSalas.astro"
import { resolveCuratorGalleries, toSalaView } from "@/data/api"
import type { SiteData } from "@/data/api"
import { getLocalizedCuratorPath, pickTranslation } from "@/lib/i18n/utils"
import type { Lang } from "@/lib/api/types"

export interface Props {
  lang: Lang
  curatorSlug: string
  siteData: SiteData
}

const { lang, curatorSlug, siteData } = Astro.props

const curator = siteData.curators.find((c) => c.slug === curatorSlug)
if (!curator) {
  throw new Error(`Unknown curator slug: ${curatorSlug}`)
}

const bio = pickTranslation(curator.translations, lang, "bio")
const curatedGalleries = resolveCuratorGalleries(curator, siteData.galleries)
const salas = curatedGalleries.map((gallery) => {
  const galleryIndex = siteData.galleries.findIndex((g) => g.slug === gallery.slug)
  return toSalaView(gallery, siteData.curators, siteData.artworks, lang, galleryIndex >= 0 ? galleryIndex : 0)
})

const alternateUrls = {
  en: getLocalizedCuratorPath(curator.slug, "en"),
  es: getLocalizedCuratorPath(curator.slug, "es"),
}
---

<PageSEO
  lang={lang}
  title={curator.name}
  description={bio || curator.name}
  ogImage={curator.photo ?? undefined}
  alternateUrls={alternateUrls}
  slot="seo"
/>

<CuratorHero curator={curator} lang={lang} bio={bio} />

<CuratorSalas salas={salas} lang={lang} />
