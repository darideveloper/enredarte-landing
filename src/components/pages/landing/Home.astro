---
import { getTranslations } from "@/lib/i18n/utils"
import PageSEO from "@/components/seo/PageSEO.astro"
import Hero from "@/components/organisms/Hero.astro"
import BannerBar from "@/components/organisms/BannerBar.astro"
import Gallery from "@/components/organisms/Gallery.astro"
import Title from "@/components/atoms/Title.astro"
import Headline from "@/components/atoms/Headline.astro"
import { Filters } from "@/components/molecules/Filters"
import { Artworks } from "@/components/organisms/Artworks"
import ImageCard from "@/components/molecules/ImageCard.astro"
import { resolveArtistName, toArtworkView, toHeroView, toSalaView } from "@/data/api"
import type { SiteData } from "@/data/api"
import type { Lang } from "@/lib/api/types"

export interface Props {
  lang: Lang
  siteData: SiteData
}

const { lang, siteData } = Astro.props
const t = getTranslations(lang)

const localizedGroups = siteData.filterGroups.map((group) => ({
  key: group.key,
  label: group.label[lang],
  options: group.options.map((option) => ({
    value: option.value,
    label: option.label[lang],
  })),
}))

const artworks = siteData.artworks.map((artwork) =>
  toArtworkView(artwork, resolveArtistName(artwork.artist, siteData.artists), lang, siteData.filterGroups)
)

const facets = artworks.map(({ artist, discipline, technique, theme, format, scale }) => ({
  artist,
  discipline,
  technique,
  theme,
  format,
  scale,
}))

const salas = siteData.galleries.map((gallery, index) =>
  toSalaView(gallery, siteData.curators, siteData.artworks, lang, index)
)

const hero = toHeroView(siteData.galleries, siteData.curators, siteData.artworks, siteData.artists, lang)
---
<PageSEO currentPage="home" lang={lang} slot="seo" />

<Hero sala={hero} />

<BannerBar />

<Gallery salas={salas} />

<section id="artworks-collection" class="bg-paper px-6 md:px-14 pt-16 md:pt-24 pb-16 md:pb-24 overflow-hidden">
  <div class="artworks-header">
    <Title>
      <Headline color="muted" class="block mb-2 tracking-[0.2em]">Explora</Headline>
      Colección completa
    </Title>
  </div>

  <Filters
    client:load
    groups={localizedGroups}
    facets={facets}
    expandLabel={t("global.filters.more")}
    collapseLabel={t("global.filters.less")}
  />

  <Artworks
    client:load
    loadingLabel={t("global.loading")}
    emptyLabel={t("global.filters.noResults")}
    resetLabel={t("global.filters.reset")}
  >
    {artworks.map((artwork) => (
      <ImageCard
        src={artwork.src}
        alt={artwork.alt}
        title={artwork.title}
        href={artwork.href}
        meta={artwork.meta}
        curator={artwork.price}
        class="aspect-[4/5]"
        data-artist={artwork.artist.join(" ")}
        data-discipline={artwork.discipline.join(" ")}
        data-technique={artwork.technique.join(" ")}
        data-theme={artwork.theme.join(" ")}
        data-format={artwork.format.join(" ")}
        data-scale={artwork.scale.join(" ")}
      />
    ))}
  </Artworks>
</section>
