---
import { getTranslations } from "@/lib/i18n/utils"
import PageSEO from "@/components/seo/PageSEO.astro"
import Hero from "@/components/organisms/Hero.astro"
import BannerBar from "@/components/organisms/BannerBar.astro"
import Gallery from "@/components/organisms/Gallery.astro"
import Title from "@/components/atoms/Title.astro"
import Headline from "@/components/atoms/Headline.astro"
import { Filters } from "@/components/molecules/Filters"
import { Artworks } from "@/components/organisms/Artworks"
import ImageCard from "@/components/molecules/ImageCard.astro"
import { artworks, filterGroups } from "@/data/catalog"

const salasData = [
  {
    src: "/images/abstract-landscape-oil.jpg",
    alt: "Sala Tierra Mundo Memoria",
    title: "Tierra, Mundo y Memoria",
    href: "#",
    isLarge: true,
    subtitle: "Sala 01 · Activa",
    meta: "6 Artistas · Los Cabos / GDL",
    curator: "Curaduría: Álvaro Macias",
  },
  {
    src: "/images/painting-abstract-details.jpg",
    alt: "Sala Plástica Oaxaqueña",
    title: "Plástica Oaxaqueña",
    href: "#",
    subtitle: "Sala 02 · Activa",
    meta: "4 Artistas · Oaxaca",
  },
  {
    src: "/images/cityscape-madrid-gran-via.jpg",
    alt: "Sala Nuevas Voces",
    title: "Nuevas Voces CDMX",
    href: "#",
    subtitle: "Sala 03 · Activa",
    meta: "5 Artistas · Ciudad de México",
  },
  {
    src: "/images/artist-street-exhibition.jpg",
    alt: "Sala San Miguel de Allende",
    title: "San Miguel de Allende",
    href: "#",
    subtitle: "Sala 04 · Próximamente",
    meta: "Curaduría: Regina Ibarra",
  },
  {
    src: "/images/abstract-mosaic-woman.jpg",
    alt: "Sala Puerto Vallarta",
    title: "Puerto Vallarta",
    href: "#",
    subtitle: "Sala 05 · Próximamente",
    meta: "Territorio de Álvaro",
  }
]

const { lang } = Astro.props
const t = getTranslations(lang)

const localizedGroups = filterGroups.map((group) => ({
  key: group.key,
  label: group[lang],
  options: group.options.map((option) => ({
    value: option.slug,
    label: option[lang],
  })),
}))
---
<PageSEO currentPage="home" lang={lang} slot="seo" />

<Hero />

<BannerBar />

<Gallery salas={salasData} />

<section class="bg-paper px-6 md:px-14 pt-16 md:pt-24 pb-16 md:pb-24">
  <Title>
    <Headline color="muted" class="block mb-2 tracking-[0.2em]">Explora</Headline>
    Colección completa
  </Title>

  <Filters
    client:load
    groups={localizedGroups}
    expandLabel={t("global.filters.more")}
    collapseLabel={t("global.filters.less")}
  />

  <Artworks client:load loadingLabel={t("global.loading")}>
    {artworks.map((artwork) => (
      <ImageCard
        src={artwork.src}
        alt={artwork.alt}
        title={artwork.title}
        href={artwork.href}
        meta={artwork.meta}
        curator={artwork.curator}
        class="aspect-[4/5]"
        data-artist={artwork.artist}
        data-discipline={artwork.discipline}
        data-technique={artwork.technique}
        data-theme={artwork.theme}
        data-format={artwork.format}
        data-scale={artwork.scale}
      />
    ))}
  </Artworks>
</section>
