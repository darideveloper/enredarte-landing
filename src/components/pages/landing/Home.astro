---
import { getTranslations } from "../../../lib/i18n/utils"
import PageSEO from "../../seo/PageSEO.astro"

const { lang } = Astro.props
const t = getTranslations(lang)
---
<PageSEO currentPage="home" lang={lang} slot="seo" />

<main class="mx-auto max-w-6xl px-4 py-16">
  <h1 class="text-4xl font-bold">{t("pages.home.title")}</h1>
  <p class="mt-4 text-lg text-gray-600">{t("pages.home.description")}</p>
</main>
