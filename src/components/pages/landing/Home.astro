---
import { getTranslations, getLocalizedPath } from "@/lib/i18n/utils"
import PageSEO from "@/components/seo/PageSEO.astro"
import Hero from "@/components/organisms/Hero.astro"
import BannerBar from "@/components/organisms/BannerBar.astro"
import Gallery from "@/components/organisms/Gallery.astro"
import Title from "@/components/atoms/Title.astro"
import Headline from "@/components/atoms/Headline.astro"
import { Filters } from "@/components/molecules/Filters"
import { Artworks } from "@/components/organisms/Artworks"
import ImageCard from "@/components/molecules/ImageCard.astro"
import { resolveArtistName, toArtworkView, toHeroView, toSalaView } from "@/data/api"
import type { SiteData } from "@/data/api"
import type { Lang } from "@/lib/api/types"
import { IMAGE_SLOTS } from "@/lib/images"
import { currencyForLang, formatPrice, pickPrice } from "@/lib/format/price"

export interface Props {
  lang: Lang
  siteData: SiteData
}

const { lang, siteData } = Astro.props
const t = getTranslations(lang)

// Curated preview: filters search the full catalog, grid shows the last N matches.
const LANDING_LIMIT = 12

const localizedGroups = siteData.filterGroups.map((group) => ({
  key: group.key,
  label: group.label[lang],
  options: group.options.map((option) => ({
    value: option.value,
    label: option.label[lang],
  })),
}))

const artworks = siteData.artworks.map((artwork) =>
  toArtworkView(artwork, resolveArtistName(artwork.artist, siteData.artists), lang, siteData.filterGroups)
)

const facets = artworks.map(({ artist, discipline, technique, theme, format, scale }) => ({
  artist,
  discipline,
  technique,
  theme,
  format,
  scale,
}))

const salas = siteData.galleries.map((gallery, index) =>
  toSalaView(gallery, siteData.curators, siteData.artworks, lang, index)
)

const hero = toHeroView(siteData.galleries, siteData.curators, siteData.artworks, siteData.artists, lang)
const homeCurrency = currencyForLang(lang)
const homePrice = (mxn: number | undefined, usd: number | undefined) =>
  formatPrice(pickPrice(mxn, usd, homeCurrency), homeCurrency)
---
<PageSEO currentPage="home" lang={lang} slot="seo" />

<Hero lang={lang} sala={hero} />

<BannerBar lang={lang} />

<Gallery salas={salas} lang={lang} />

<section id="artworks-collection" class="bg-paper container-site-canvas pt-16 md:pt-24 pb-16 md:pb-24 overflow-hidden" transition:animate="none">
  <div class="artworks-header js-home-header">
    <Title
      linkText={t("pages.home.collection.viewObras")}
      linkHref={getLocalizedPath("obras", lang)}
    >
      <Headline color="muted" class="block mb-2 tracking-[0.2em]">{t("pages.home.collection.eyebrow")}</Headline>
      {t("pages.home.collection.title")}
    </Title>
    <a href={getLocalizedPath("artistas", lang)} class="mt-2 inline-block text-sm uppercase tracking-[0.1em] text-crimson">{t("pages.home.collection.viewArtistas")}</a>
  </div>

  <Filters
    client:load
    groups={localizedGroups}
    facets={facets}
    expandLabel={t("global.filters.more")}
    collapseLabel={t("global.filters.less")}
  />

  <Artworks
    client:load
    loadingLabel={t("global.loading")}
    emptyLabel={t("global.filters.noResults")}
    resetLabel={t("global.filters.reset")}
    limit={LANDING_LIMIT}
  >
    {artworks.map((artwork) => (
      <ImageCard
        src={artwork.src}
        alt={artwork.alt}
        title={artwork.title}
        href={artwork.href}
        meta={artwork.meta}
        price={homePrice(artwork.priceMxn, artwork.priceUsd)}
        widths={IMAGE_SLOTS.grid.widths}
        sizes={IMAGE_SLOTS.grid.sizes}
        class="aspect-[4/5] js-home-card"
        data-artist={artwork.artist.join(" ")}
        data-discipline={artwork.discipline.join(" ")}
        data-technique={artwork.technique.join(" ")}
        data-theme={artwork.theme.join(" ")}
        data-format={artwork.format.join(" ")}
        data-scale={artwork.scale.join(" ")}
      />
    ))}
  </Artworks>
</section>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap"

  let mm: ReturnType<typeof gsap.matchMedia> | undefined
  let filterObserver: MutationObserver | undefined
  let refreshTimer: ReturnType<typeof setTimeout> | undefined

  const initHomeCollection = () => {
    const section = document.querySelector("#artworks-collection")
    if (!section) return
    mm?.revert()
    filterObserver?.disconnect()
    mm = gsap.matchMedia()

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const header = section.querySelector(".js-home-header")
      if (header) {
        gsap.fromTo(
          header,
          { y: 30, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: section,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          }
        )
      }

      section.querySelectorAll(".js-home-card").forEach((card) => {
        gsap.fromTo(
          card,
          { y: 40, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.8,
            ease: "power2.out",
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: card,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          }
        )
      })

      // Filtering flips card.hidden at runtime — re-measure triggers below the grid.
      filterObserver = new MutationObserver(() => {
        clearTimeout(refreshTimer)
        refreshTimer = setTimeout(() => ScrollTrigger.refresh(), 150)
      })
      filterObserver.observe(section, { attributes: true, attributeFilter: ["hidden"], subtree: true })

      return () => {
        filterObserver?.disconnect()
        filterObserver = undefined
      }
    })

    mm.add("(prefers-reduced-motion: reduce)", () => {
      // no-op: content is visible by default with fromTo+clearProps
    })
  }

  document.addEventListener("astro:after-swap", () => {
    mm?.revert()
    filterObserver?.disconnect()
  })
  document.addEventListener("astro:page-load", initHomeCollection)
  initHomeCollection()
</script>
