---
import { getCollection } from "astro:content"
import PageSEO from "@/components/seo/PageSEO.astro"
import Headline from "@/components/atoms/Headline.astro"
import Markdown from "@/components/atoms/Markdown.astro"
import { getTranslations, getLocalizedPath } from "@/lib/i18n/utils"
import type { Lang } from "@/lib/api/types"

export interface Props {
  lang: Lang
  pageKey: "aviso-de-privacidad" | "terminos-y-condiciones" | "politica-de-cookies"
}

const { lang, pageKey } = Astro.props
const t = getTranslations(lang)

// Both language files are required per slug — a missing file fails the build.
const entries = await getCollection("legal")
const entry = entries.find((e) => e.id === `${pageKey}.${lang}`)
if (!entry) {
  throw new Error(`Missing legal entry: ${pageKey}.${lang} (both .es.md and .en.md are required)`)
}
const { title, description, updated } = entry.data

const legalKey = pageKey === "aviso-de-privacidad"
  ? "privacy"
  : pageKey === "terminos-y-condiciones"
    ? "terms"
    : "cookies"

const related = (
  [
    { key: "privacy", pageKey: "aviso-de-privacidad" },
    { key: "terms", pageKey: "terminos-y-condiciones" },
    { key: "cookies", pageKey: "politica-de-cookies" },
  ] as const
).filter((r) => r.key !== legalKey)
---

<PageSEO currentPage={pageKey} lang={lang} title={title} description={description} slot="seo" />

<div class="container-site-narrow py-16" transition:animate="none">
  <div class="js-legal-head">
  <Headline>{t("global.footer.legal.label")}</Headline>
  <h1 class="mt-4 font-serif text-4xl text-ink">{title}</h1>
  <p class="mt-2 text-sm text-muted">{description}</p>
  <p class="mt-1 text-xs uppercase tracking-[0.1em] text-muted">{updated}</p>
  </div>
  <div class="js-legal-list mt-10">
    <Markdown content={entry.body} />
  </div>
  <nav aria-label={t("global.footer.legal.label")} class="mt-12 border-t border-border-theme pt-6">
    <p class="text-xs uppercase tracking-[0.1em] text-muted">{t("global.footer.legal.label")}</p>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
      {related.map((r) => (
        <li>
          <a class="text-sm text-crimson underline underline-offset-4 hover:decoration-crimson" href={getLocalizedPath(r.pageKey, lang)}>
            {t(`global.footer.legal.${r.key}`)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  import { gsap } from "@/lib/gsap"

  let mm: ReturnType<typeof gsap.matchMedia> | undefined

  const initLegal = () => {
    const head = document.querySelector(".js-legal-head")
    const list = document.querySelector(".js-legal-list")
    if (!head && !list) return
    mm?.revert()
    mm = gsap.matchMedia()

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      if (head) {
        gsap.fromTo(
          head,
          { y: 30, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: head,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          }
        )
      }

      if (list) {
        gsap.fromTo(
          list,
          { y: 30, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.7,
            ease: "power2.out",
            clearProps: "transform,opacity,visibility",
            scrollTrigger: {
              trigger: list,
              start: "top 80%",
              toggleActions: "play none none none",
            },
          }
        )
      }
    })

    mm.add("(prefers-reduced-motion: reduce)", () => {
      // no-op: content is visible by default with fromTo+clearProps
    })
  }

  document.addEventListener("astro:after-swap", () => mm?.revert())
  document.addEventListener("astro:page-load", initLegal)
  initLegal()
</script>
