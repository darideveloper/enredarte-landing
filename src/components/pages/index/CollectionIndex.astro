---
import PageSEO from "@/components/seo/PageSEO.astro"
import Title from "@/components/atoms/Title.astro"
import Headline from "@/components/atoms/Headline.astro"
import ImageCard from "@/components/molecules/ImageCard.astro"
import { Filters } from "@/components/molecules/Filters"
import { Artworks } from "@/components/organisms/Artworks"
import {
  resolveArtistArtworks,
  resolveArtistName,
  toArtworkView,
  toSalaView,
} from "@/data/api"
import type { SiteData } from "@/data/api"
import type { Lang } from "@/lib/api/types"
import { getTranslations, getLocalizedArtistPath, getLocalizedCuratorPath, pickTranslation } from "@/lib/i18n/utils"
import { currencyForLang, formatPrice, pickPrice } from "@/lib/format/price"

export interface Props {
  lang: Lang
  pageKey: "obras" | "salas" | "artistas" | "curadores"
  siteData: SiteData
}

const { lang, pageKey, siteData } = Astro.props
const t = getTranslations(lang)

const eyebrow = t(`pages.${pageKey}.eyebrow`) as string
const title = t(`pages.${pageKey}.title`) as string
const description = t(`pages.${pageKey}.description`) as string

const cards = pageKey === "obras"
  ? []
  : pageKey === "salas"
    ? siteData.galleries.map((gallery, index) => {
        const view = toSalaView(gallery, siteData.curators, siteData.artworks, lang, index)
        return { src: view.src, alt: view.alt, title: view.title, href: view.href, meta: view.meta }
      })
    : pageKey === "artistas"
      ? siteData.artists.map((artist) => {
          const works = resolveArtistArtworks(artist, siteData.artworks)
          const img = works[0]?.images.find((i) => i.is_primary) ?? works[0]?.images[0]
          const name = artist.name || artist.slug
          return {
            src: artist.photo ?? img?.image ?? "",
            alt: name,
            title: name,
            href: getLocalizedArtistPath(artist.slug, lang),
            meta: t("global.artist.works"),
          }
        })
      : siteData.curators.map((curator) => ({
          src: curator.photo ?? "",
          alt: curator.name,
          title: curator.name,
          href: getLocalizedCuratorPath(curator.slug, lang),
          meta: t("global.curator.curator"),
        }))

// Obras catalog (mirrors Home.astro): full catalog, same filters + grid, no cap.
// siteData.artworks order is preserved (no re-sorting) so Artworks tail semantics hold.
const obrasArtworks = pageKey === "obras"
  ? siteData.artworks.map((artwork) =>
      toArtworkView(artwork, resolveArtistName(artwork.artist, siteData.artists), lang, siteData.filterGroups)
    )
  : []

const obrasGroups = siteData.filterGroups.map((group) => ({
  key: group.key,
  label: group.label[lang],
  options: group.options.map((option) => ({
    value: option.value,
    label: option.label[lang],
  })),
}))

const obrasFacets = obrasArtworks.map(({ artist, discipline, technique, theme, format, scale }) => ({
  artist,
  discipline,
  technique,
  theme,
  format,
  scale,
}))

const obrasCurrency = currencyForLang(lang)
const obrasPrice = (mxn: number | undefined, usd: number | undefined) =>
  formatPrice(pickPrice(mxn, usd, obrasCurrency), obrasCurrency)
---

<PageSEO currentPage={pageKey} lang={lang} title={title} description={description} slot="seo" />

<div class="mx-auto max-w-6xl px-6 py-16 md:px-14">
  <Title>
    <Headline color="muted" class="block mb-2 tracking-[0.2em]">{eyebrow}</Headline>
    {title}
  </Title>
  <p class="mt-2 text-sm text-muted">{description}</p>
  {pageKey === "obras" ? (
    <>
      <div class="mt-10">
        <Filters
          client:load
          groups={obrasGroups}
          facets={obrasFacets}
          expandLabel={t("global.filters.more")}
          collapseLabel={t("global.filters.less")}
        />
      </div>
      <Artworks
        client:load
        loadingLabel={t("global.loading")}
        emptyLabel={t("global.filters.noResults")}
        resetLabel={t("global.filters.reset")}
      >
        {obrasArtworks.map((artwork) => (
          <ImageCard
            src={artwork.src}
            alt={artwork.alt}
            title={artwork.title}
            href={artwork.href}
            meta={artwork.meta}
            price={obrasPrice(artwork.priceMxn, artwork.priceUsd)}
            class="aspect-[4/5]"
            data-artist={artwork.artist.join(" ")}
            data-discipline={artwork.discipline.join(" ")}
            data-technique={artwork.technique.join(" ")}
            data-theme={artwork.theme.join(" ")}
            data-format={artwork.format.join(" ")}
            data-scale={artwork.scale.join(" ")}
          />
        ))}
      </Artworks>
    </>
  ) : (
    <div class={pageKey === "artistas"
      ? "mt-10 grid grid-cols-1 gap-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
      : "mt-10 grid grid-cols-1 gap-1 sm:grid-cols-2 lg:grid-cols-3"}>
      {cards.map((card) => (
        <ImageCard {...card} class="aspect-[4/5]" />
      ))}
    </div>
  )}
</div>
