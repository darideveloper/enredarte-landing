---
import { getTranslations } from "../../../lib/i18n/utils"
import PageSEO from "../../seo/PageSEO.astro"
import { Button } from "../../atoms/Button"

const { lang, pageKey } = Astro.props
const t = getTranslations(lang)

const services = [
  { title: t("pages.services.items.exhibitions"), description: t("pages.services.items.exhibitionsDesc") },
  { title: t("pages.services.items.workshops"), description: t("pages.services.items.workshopsDesc") },
  { title: t("pages.services.items.tours"), description: t("pages.services.items.toursDesc") },
]
---

<PageSEO currentPage={pageKey} lang={lang} slot="seo" />

<section class="mx-auto max-w-6xl px-4 py-16">
  <h1 class="text-4xl font-bold text-gray-900">{t("pages.services.title")}</h1>
  <p class="mt-2 text-lg text-gray-600">{t("pages.services.description")}</p>

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((service) => (
      <article class="rounded-lg border border-gray-200 p-6 shadow-sm transition-shadow hover:shadow-md">
        <h2 class="text-xl font-semibold text-gray-900">{service.title}</h2>
        <p class="mt-2 text-sm text-gray-600">{service.description}</p>
        <Button class="mt-4" variant="secondary" size="sm">
          {t("global.learnMore")}
        </Button>
      </article>
    ))}
  </div>
</section>
