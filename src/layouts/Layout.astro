---
import "@/styles/global.css"
import Header from "@/components/organisms/Header.astro"
import Footer from "@/components/organisms/Footer.astro"
import ConsentBanner from "@/components/organisms/ConsentBanner.astro"
import { getLangFromUrl } from "@/lib/i18n/utils"
import { ClientRouter } from "astro:transitions"

export interface Props {
  preloadImage?: string
  preloadSrcSet?: string
  preloadSizes?: string
  localizedPaths?: Record<"en" | "es", string>
}

const { preloadImage, preloadSrcSet, preloadSizes, localizedPaths } = Astro.props
const lang = getLangFromUrl(Astro.url)
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Consent Mode v2 defaults: everything denied before the visitor chooses.
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag("consent", "default", {
        ad_storage: "denied",
        analytics_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 500,
      });
    </script>
    <ClientRouter />
    <slot name="seo" />
    {preloadSrcSet
      ? <link rel="preload" as="image" imagesrcset={preloadSrcSet} imagesizes={preloadSizes ?? "100vw"} fetchpriority="high" />
      : preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  </head>
  <body class="flex min-h-screen flex-col font-sans bg-paper">
    <Header localizedPaths={localizedPaths} />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
