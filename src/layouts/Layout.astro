---
import "@/styles/global.css"
import Header from "@/components/organisms/Header.astro"
import Footer from "@/components/organisms/Footer.astro"
import Tracking from "@/components/seo/base/Tracking.astro"
import { getLangFromUrl } from "@/lib/i18n/utils"
import { ClientRouter } from "astro:transitions"

export interface Props {
  preloadImage?: string
  preloadSrcSet?: string
  preloadSizes?: string
  localizedPaths?: Record<"en" | "es", string>
}

const { preloadImage, preloadSrcSet, preloadSizes, localizedPaths } = Astro.props
const lang = getLangFromUrl(Astro.url)
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <Tracking />
    <ClientRouter />
    {lang === "es"
      ? <link rel="alternate" type="application/rss+xml" title="Revista EnredArte" href="/rss.xml" />
      : <link rel="alternate" type="application/rss+xml" title="EnredArte Journal" href="/en/rss.xml" />}
    <slot name="seo" />
    {preloadSrcSet
      ? <link rel="preload" as="image" imagesrcset={preloadSrcSet} imagesizes={preloadSizes ?? "100vw"} fetchpriority="high" />
      : preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  </head>
  <body class="flex min-h-screen flex-col font-sans bg-paper">
    <Header localizedPaths={localizedPaths} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
